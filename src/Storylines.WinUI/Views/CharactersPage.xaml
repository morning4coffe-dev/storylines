<Page x:Class="Storylines.WinUI.Views.CharactersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
      xmlns:models="using:Storylines.WinUI.Models"
      mc:Ignorable="d">

    <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="listViewColumn"
                              Width="*" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="3*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="8" />
            <RowDefinition Height="*" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="2"
              Margin="12,0,2,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="28" />
                <RowDefinition Height="10" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid>
                <TextBlock x:Uid="charactersText1"
                           VerticalAlignment="Center"
                           FontWeight="Medium" />
                <StackPanel HorizontalAlignment="Right"
                            Orientation="Horizontal"
                            Spacing="4">
                    <Button x:Name="flyoutDisplayButton"
                            Width="32"
                            Height="28"
                            Background="Transparent"
                            BorderThickness="0">
                        <FontIcon Width="20"
                                  Margin="-8"
                                  Glyph=""
                                  RenderTransformOrigin=".5,.5">
                            <FontIcon.RenderTransform>
                                <CompositeTransform ScaleX=".6"
                                                    ScaleY=".6" />
                            </FontIcon.RenderTransform>
                        </FontIcon>
                    </Button>
                </StackPanel>
            </Grid>

            <Rectangle Grid.Row="1"
                       Height="0.5"
                       VerticalAlignment="Center"
                       Fill="{ThemeResource SeparatorFill}"
                       Opacity=".1" />

            <ListView x:Name="listView"
                      Grid.Row="2"
                      Margin="-5,0"
                      ItemsSource="{x:Bind ViewModel.Characters, Mode=OneWay}"
                      SelectedItem="{x:Bind ViewModel.SelectedCharacter, Mode=TwoWay}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:Character">
                        <Grid HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="8"
                                        ToolTipService.ToolTip="{Binding Name}">
                                <PersonPicture x:Name="profilePicture"
                                               Height="40"
                                               DisplayName="{Binding Name}"
                                               ProfilePicture="{Binding Picture.Image}" />
                                <StackPanel Margin="0,8">
                                    <TextBlock FontWeight="Bold"
                                               Text="{Binding Name}" />
                                    <TextBlock Text="{Binding Description}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <StackPanel x:Name="charactersNullText"
                        Grid.Row="2"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="18"
                        Visibility="{x:Bind ViewModel.Characters.Count, Converter={StaticResource IntToVisibilityConverter}, Mode=OneWay}">
                <FontIcon Glyph=""
                          RenderTransformOrigin=".5,.5">
                    <FontIcon.RenderTransform>
                        <CompositeTransform ScaleX="1.9"
                                            ScaleY="1.8" />
                    </FontIcon.RenderTransform>
                </FontIcon>
                <RichTextBlock Margin="20,0"
                               FontSize="16"
                               TextAlignment="Center">
                    <Paragraph>
                        <Run x:Uid="noCharacters" />
                        <LineBreak />
                        <Hyperlink Command="{x:Bind ViewModel.AddCharacterCommand}">
                            <Run x:Uid="clickHereText" />
                        </Hyperlink>
                        <Run x:Uid="toAddNew" />
                    </Paragraph>
                </RichTextBlock>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="3"
                    Padding="5"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource ElementBorderColor}"
                    BorderThickness="{ThemeResource ElementBorderThickness}"
                    CornerRadius="0, 8, 0, 0"
                    Orientation="Horizontal">
            <TextBlock x:Name="charactersCountText"
                       x:Uid="charactersPageCharactersCount"
                       Margin="5,0" />
            <TextBlock Text="{x:Bind ViewModel.Characters.Count, Mode=OneWay}" />
        </StackPanel>

        <Frame Grid.ColumnSpan="3"
               Margin="8,0"
               Background="{ThemeResource LayerFillColorDefaultBrush}"
               BorderBrush="{ThemeResource ElementBorderColor}"
               BorderThickness="{ThemeResource ElementBorderThickness}"
               CornerRadius="8" />
        <CommandBar Grid.ColumnSpan="3"
                    Margin="8,0"
                    HorizontalAlignment="Left"
                    Background="Transparent"
                    DefaultLabelPosition="Right"
                    IsOpen="False"
                    OverflowButtonVisibility="Auto">
            <AppBarButton x:Name="undoButton"
                          Command="{x:Bind ViewModel.UndoCommand}"
                          IsEnabled="{x:Bind ViewModel.CanUndo, Mode=OneWay}">
                <AppBarButton.Icon>
                    <SymbolIcon Symbol="Undo" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton x:Name="redoButton"
                          Command="{x:Bind ViewModel.RedoCommand}"
                          IsEnabled="{x:Bind ViewModel.CanRedo, Mode=OneWay}">
                <AppBarButton.Icon>
                    <SymbolIcon Symbol="Redo" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarSeparator />
            <AppBarButton x:Name="addButton"
                          x:Uid="add"
                          Command="{x:Bind ViewModel.AddCharacterCommand}"
                          IsCompact="True">
                <AppBarButton.Icon>
                    <FontIcon Glyph="" />
                </AppBarButton.Icon>
            </AppBarButton>

            <AppBarToggleButton x:Name="editButton"
                                IsChecked="{x:Bind ViewModel.IsEditModeEnabled, Mode=TwoWay}"
                                IsEnabled="{x:Bind ViewModel.SelectedCharacter, Converter={StaticResource NullToBooleanConverter}, Mode=OneWay}">
                <AppBarToggleButton.Icon>
                    <FontIcon x:Name="editButtonIcon" />
                </AppBarToggleButton.Icon>
            </AppBarToggleButton>
            <AppBarElementContainer x:Name="cancelButton"
                                    Margin="2,0"
                                    VerticalAlignment="Center"
                                    Visibility="{x:Bind ViewModel.IsEditModeEnabled, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}">
                <Button x:Uid="cancel"
                        Height="36"
                        VerticalAlignment="Center"
                        Command="{x:Bind ViewModel.CancelEditCommand}" />
            </AppBarElementContainer>
            <AppBarButton x:Name="exportButton"
                          x:Uid="export"
                          Command="{x:Bind ViewModel.ExportCommand}">
                <AppBarButton.Icon>
                    <FontIcon Glyph="" />
                </AppBarButton.Icon>
            </AppBarButton>
        </CommandBar>

        <Frame Grid.Row="2"
               Grid.RowSpan="2"
               Grid.Column="2"
               Background="{ThemeResource LayerFillColorDefaultBrush}"
               BorderBrush="{ThemeResource ElementBorderColor}"
               BorderThickness="{ThemeResource ElementBorderThickness}"
               CornerRadius="8, 0, 0, 0" />
        <StackPanel x:Name="characterValuesPanel"
                    Grid.Row="2"
                    Grid.Column="2"
                    Margin="35,30"
                    Spacing="20"
                    Visibility="{x:Bind ViewModel.SelectedCharacter, Converter={StaticResource NullToVisibilityConverter}, Mode=OneWay}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <PersonPicture x:Name="profilePicture"
                               Height="60"
                               DisplayName="{x:Bind ViewModel.SelectedCharacter.Name, Mode=OneWay}"
                               ProfilePicture="{x:Bind ViewModel.SelectedCharacter.Picture.Image, Mode=OneWay}" />
                <Button Width="60"
                        Height="60"
                        Command="{x:Bind ViewModel.ChangeProfilePictureCommand}"
                        IsEnabled="{x:Bind ViewModel.IsEditModeEnabled, Mode=OneWay}" />
                <TextBox x:Name="nameBox"
                         x:Uid="characterPlaceholderName"
                         Grid.Column="2"
                         Height="38"
                         Padding="12,7"
                         HorizontalAlignment="Stretch"
                         CornerRadius="4"
                         IsEnabled="{x:Bind ViewModel.IsEditModeEnabled, Mode=OneWay}"
                         PlaceholderText="Name"
                         Text="{x:Bind ViewModel.SelectedCharacter.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>
            <TextBox x:Name="descriptionBox"
                     x:Uid="ownDescription"
                     Height="250"
                     CornerRadius="4"
                     IsEnabled="{x:Bind ViewModel.IsEditModeEnabled, Mode=OneWay}"
                     Text="{x:Bind ViewModel.SelectedCharacter.Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel x:Name="selectedCharactersNullText"
                    Grid.Row="2"
                    Grid.Column="2"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="18"
                    Visibility="{x:Bind ViewModel.SelectedCharacter, Converter={StaticResource NullToVisibilityConverter}, Mode=OneWay, ConverterParameter=True}">
            <FontIcon Glyph=""
                      RenderTransformOrigin=".5,.5">
                <FontIcon.RenderTransform>
                    <CompositeTransform ScaleX="1.9"
                                        ScaleY="1.8" />
                </FontIcon.RenderTransform>
            </FontIcon>
            <TextBlock x:Uid="characterNotSelected"
                       FontSize="16" />
        </StackPanel>
    </Grid>
</Page>
