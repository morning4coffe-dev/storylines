<UserControl x:Class="Storylines.Components.ChapterNotesPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:animations="using:Microsoft.Toolkit.Uwp.UI.Animations"
             mc:Ignorable="d"
             d:DesignHeight="200"
             d:DesignWidth="600">

    <Grid x:Name="notesPaneRoot"
          Background="{ThemeResource LayerFillColorDefaultBrush}"
          BorderBrush="{ThemeResource ElementBorderColor}"
          BorderThickness="{ThemeResource ElementBorderThickness}"
          CornerRadius="8"
          Padding="12,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <FontIcon Glyph="&#xE70B;"
                      FontSize="14"
                      Margin="0,0,8,0"
                      VerticalAlignment="Center"
                      Opacity="0.7" />
            <TextBlock Text="Chapter Notes"
                       Grid.Column="1"
                       FontWeight="Medium"
                       FontSize="12"
                       VerticalAlignment="Center"
                       Opacity="0.8" />
            <Button Grid.Column="2"
                    Width="28" Height="28"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="0"
                    Click="OnCollapseButton_Click"
                    ToolTipService.ToolTip="Hide Notes">
                <SymbolIcon Symbol="Cancel"
                            RenderTransformOrigin=".5,.5">
                    <SymbolIcon.RenderTransform>
                        <CompositeTransform ScaleX=".55" ScaleY=".55" />
                    </SymbolIcon.RenderTransform>
                </SymbolIcon>
            </Button>
        </Grid>

        <TextBox x:Name="notesTextBox"
                 x:FieldModifier="public"
                 Grid.Row="1"
                 PlaceholderText="Add notes for this chapter..."
                 TextWrapping="Wrap"
                 AcceptsReturn="True"
                 Background="Transparent"
                 BorderThickness="0"
                 Padding="0,4"
                 FontSize="13"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 TextChanged="OnNotesTextBox_TextChanged" />

        <animations:Implicit.ShowAnimations>
            <animations:TranslationAnimation Duration="0:0:0.25"
                                             From="0, 20, 0"
                                             To="0"
                                             EasingMode="EaseOut" />
            <animations:OpacityAnimation Duration="0:0:0.2"
                                         From="0"
                                         To="1.0" />
        </animations:Implicit.ShowAnimations>
    </Grid>
</UserControl>
