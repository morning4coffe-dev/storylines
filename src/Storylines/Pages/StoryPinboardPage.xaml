<Page x:Class="Storylines.Pages.StoryPinboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:variables="using:Storylines.Scripts.Variables"
      xmlns:animations="using:Microsoft.Toolkit.Uwp.UI.Animations"
      mc:Ignorable="d"
      Loaded="Page_Loaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Padding="20,16"
              Background="{ThemeResource LayerFillColorDefaultBrush}"
              BorderBrush="{ThemeResource ElementBorderColor}"
              BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="backButton"
                    Background="Transparent"
                    BorderThickness="0"
                    CornerRadius="4"
                    Padding="8"
                    Click="OnBackButton_Click">
                <FontIcon Glyph="&#xE72B;" FontSize="14" />
            </Button>
            <StackPanel Grid.Column="1"
                        Margin="12,0"
                        VerticalAlignment="Center">
                <TextBlock Text="Story Pinboard"
                           FontSize="18"
                           FontWeight="SemiBold" />
                <TextBlock x:Name="subtitleText"
                           FontSize="12"
                           Opacity="0.6" />
            </StackPanel>
            <TextBlock Grid.Column="2"
                       Text="Drag cards to reorder chapters"
                       FontSize="11"
                       Opacity="0.5"
                       VerticalAlignment="Center" />
        </Grid>

        <!-- Chapter cards in a horizontal scrollable list -->
        <ScrollViewer Grid.Row="1"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled"
                      HorizontalScrollMode="Enabled"
                      VerticalScrollMode="Disabled"
                      Padding="20,20,20,20">
            <ListView x:Name="pinboardList"
                      Orientation="Horizontal"
                      SelectionMode="None"
                      CanReorderItems="True"
                      CanDragItems="True"
                      AllowDrop="True"
                      DragItemsStarting="OnDragItemsStarting"
                      DragItemsCompleted="OnDragItemsCompleted">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,12,0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="variables:Chapter">
                        <Grid Width="220"
                              MinHeight="180"
                              Padding="16"
                              CornerRadius="8"
                              Background="{ThemeResource LayerFillColorDefaultBrush}"
                              BorderBrush="{ThemeResource ElementBorderColor}"
                              BorderThickness="{ThemeResource ElementBorderThickness}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Chapter name -->
                            <TextBlock Text="{Binding name}"
                                       FontWeight="SemiBold"
                                       FontSize="13"
                                       TextWrapping="Wrap"
                                       MaxLines="2"
                                       TextTrimming="CharacterEllipsis" />

                            <!-- Separator -->
                            <Rectangle Grid.Row="1"
                                       Height="1"
                                       Fill="{ThemeResource SeparatorFill}"
                                       Opacity="0.15"
                                       Margin="0,8" />

                            <!-- Synopsis excerpt -->
                            <TextBlock Grid.Row="2"
                                       Text="{Binding synopsis}"
                                       FontSize="12"
                                       Opacity="0.65"
                                       TextWrapping="Wrap"
                                       MaxLines="5"
                                       TextTrimming="CharacterEllipsis" />

                            <!-- Tag pills -->
                            <ItemsRepeater Grid.Row="3"
                                           ItemsSource="{Binding tags}"
                                           Margin="0,8,0,0">
                                <ItemsRepeater.Layout>
                                    <StackLayout Orientation="Horizontal" Spacing="3" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Border CornerRadius="3"
                                                Padding="5,1"
                                                Background="{ThemeResource SystemAccentColorLight2}"
                                                Opacity="0.85">
                                            <TextBlock Text="{x:Bind}"
                                                       FontSize="10"
                                                       Foreground="White" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>

                            <!-- Word count -->
                            <TextBlock x:Name="wordCountText"
                                       Grid.Row="4"
                                       FontSize="11"
                                       Opacity="0.45"
                                       Margin="0,8,0,0"
                                       Tag="{Binding token}" />

                            <animations:Implicit.ShowAnimations>
                                <animations:OpacityAnimation Duration="0:0:0.3" From="0" To="1" />
                                <animations:TranslationAnimation Duration="0:0:0.3" From="0,20,0" To="0" />
                            </animations:Implicit.ShowAnimations>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </ScrollViewer>

        <!-- Empty state -->
        <StackPanel x:Name="emptyState"
                    Grid.Row="1"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Spacing="12"
                    Visibility="Collapsed">
            <FontIcon Glyph="&#xE8A1;"
                      FontSize="48"
                      HorizontalAlignment="Center"
                      Opacity="0.3" />
            <TextBlock Text="No chapters yet"
                       FontSize="16"
                       HorizontalAlignment="Center"
                       Opacity="0.5" />
            <TextBlock Text="Add chapters from the main writing page to see them here."
                       FontSize="12"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       Opacity="0.4" />
        </StackPanel>
    </Grid>
</Page>
