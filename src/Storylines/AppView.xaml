<Page x:Class="Storylines.AppView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:animations="using:CommunityToolkit.WinUI.Animations"
      xmlns:vm="using:Storylines.ViewModels"
      KeyboardAcceleratorPlacementMode="Hidden"
      mc:Ignorable="d"
      Background="{ThemeResource AppAcrylicBackground}">

    <!--  Global keyboard accelerators. Per-page accelerators live in each Page's XAML.
          Handlers route through EventAggregator events or App.GetService to avoid coupling
          the shell to any specific page. ShortcutManager handles the Ctrl+Shift combos below
          at the CoreWindow level; these accelerators handle the remaining standard ones that
          don't need page-context checks. -->
    <Page.KeyboardAccelerators>
        <!--  File operations  -->
        <KeyboardAccelerator Modifiers="Control"
                             Key="S"
                             Invoked="OnSaveAccelerator" />
        <KeyboardAccelerator Modifiers="Control,Shift"
                             Key="S"
                             Invoked="OnSaveCopyAccelerator" />
        <KeyboardAccelerator Modifiers="Control"
                             Key="Z"
                             Invoked="OnUndoAccelerator" />
        <KeyboardAccelerator Modifiers="Control"
                             Key="Y"
                             Invoked="OnRedoAccelerator" />
        <!--  Navigation  -->
        <KeyboardAccelerator Modifiers="Control"
                             Key="K"
                             Invoked="OnCommandPaletteAccelerator" />
        <KeyboardAccelerator Key="F11"
                             Invoked="OnFocusModeAccelerator" />
        <!--  Speech  -->
        <KeyboardAccelerator Modifiers="Control,Shift"
                             Key="P"
                             Invoked="OnReadAloudAccelerator" />
        <KeyboardAccelerator Modifiers="Control,Shift"
                             Key="D"
                             Invoked="OnDictationAccelerator" />
    </Page.KeyboardAccelerators>

    <Grid AllowDrop="True"
          DragOver="OnGrid_DragOver"
          Drop="OnGrid_Drop">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TitleBar x:Name="appTitleBar"
                  x:FieldModifier="public"
                  Background="Transparent"
                  Title="{x:Bind ViewModel.TitleText, Mode=OneWay}"
                  Subtitle="{x:Bind ViewModel.UnsavedIndicatorText, Mode=OneWay}"
                  IsPaneToggleButtonVisible="False"
                  IsBackButtonVisible="{x:Bind ViewModel.IsBackButtonVisible, Mode=OneWay}"
                  IsBackButtonEnabled="{x:Bind ViewModel.IsBackButtonEnabled, Mode=OneWay}"
                  BackRequested="OnAppTitleBar_BackRequested">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/StoreLogo.png" />
            </TitleBar.IconSource>

            <TitleBar.Content>
                <AutoSuggestBox x:Name="titleBarSearchBox"
                                Width="320"
                                MinWidth="220"
                                MaxWidth="420"
                                QueryIcon="Find"
                                Visibility="{x:Bind ViewModel.TitleBarSearchVisibility, Mode=OneWay}"
                                PlaceholderText="{x:Bind ViewModel.SearchText, Mode=OneWay}"
                                QuerySubmitted="OnTitleBarSearchBox_QuerySubmitted" />
            </TitleBar.Content>

            <!--<TitleBar.RightHeader>
                <PersonPicture Initials="DT" Height="32"/>
            </TitleBar.RightHeader>-->
        </TitleBar>

        <Grid x:Name="mainGrid"
              Grid.Row="1"
              x:FieldModifier="public">
            <Frame x:Name="pagesView"
                   x:FieldModifier="public">
                <Frame.ContentTransitions>
                    <TransitionCollection>
                        <NavigationThemeTransition>
                            <NavigationThemeTransition.DefaultNavigationTransitionInfo>
                                <DrillInNavigationTransitionInfo />
                            </NavigationThemeTransition.DefaultNavigationTransitionInfo>
                        </NavigationThemeTransition>
                    </TransitionCollection>
                </Frame.ContentTransitions>
            </Frame>
        </Grid>

        <InfoBar x:Name="updateAvailableInfoBar"
                      x:FieldModifier="public"
                      x:Uid="updateAvailableTitle"
                      IsOpen="False"
                      Visibility="Collapsed"
                      Severity="Informational"
                      Background="{ThemeResource SystemControlBaseHighAcrylicElementBrush}"
                      BorderBrush="{ThemeResource ElementBorderColor}"
                      BorderThickness="{ThemeResource ElementBorderThickness}"
                      Grid.Row="1"
                      VerticalAlignment="Bottom"
                      HorizontalAlignment="Center"
                      Width="440"
                      Margin="0, 80"
                      Closed="OnUpdateAvailableInfoBar_Closed">
            <InfoBar.Content>
                <StackPanel Margin="0,-4,0,0"
                            Spacing="10">
                    <TextBlock x:Name="updateAvailableInfoBarText"
                               x:FieldModifier="public"
                               x:Uid="storeUpdateAvailableMessage"
                               TextWrapping="WrapWholeWords" />
                    <TextBlock x:Name="updateAvailableInfoBarDetailText"
                               x:FieldModifier="public"
                               Visibility="Collapsed"
                               Opacity="0.85"
                               TextWrapping="WrapWholeWords" />
                    <ProgressBar x:Name="updateAvailableProgressBar"
                                 x:FieldModifier="public"
                                 Minimum="0"
                                 Maximum="100"
                                 Height="4"
                                 Visibility="Collapsed" />
                    <StackPanel x:Name="updateAvailableActionsPanel"
                                x:FieldModifier="public"
                                Orientation="Horizontal"
                                Spacing="8"
                                Margin="0,0,0,12">
                        <Button x:Name="updateAvailablePrimaryButton"
                                x:FieldModifier="public"
                                x:Uid="storeUpdateInstallNow"
                                Click="OnUpdateAvailablePrimaryButton_Click" />
                        <Button x:Name="updateAvailableSecondaryButton"
                                x:FieldModifier="public"
                                x:Uid="storeUpdateLater"
                                Click="OnUpdateAvailableSecondaryButton_Click" />
                    </StackPanel>
                </StackPanel>
            </InfoBar.Content>
            <InfoBar.IconSource>
                <FontIconSource Glyph="" />
            </InfoBar.IconSource>

            <animations:Implicit.ShowAnimations>
                <animations:TranslationAnimation Duration="0:0:0.5"
                                                 From="0, 35, 0"
                                                 To="0"
                                                 EasingMode="EaseOut"
                                                 EasingType="Back" />
                <animations:OpacityAnimation Duration="0:0:0.5"
                                             From="0"
                                             To="1.0" />
            </animations:Implicit.ShowAnimations>
            <animations:Implicit.HideAnimations>
                <animations:TranslationAnimation Duration="0:0:0.5"
                                                 From="0"
                                                 To="0, 35, 0"
                                                 EasingMode="EaseIn"
                                                 EasingType="Back" />
                <animations:OpacityAnimation Duration="0:0:0.5"
                                             From="1.0"
                                             To="0" />
            </animations:Implicit.HideAnimations>
        </InfoBar>

        <InfoBar x:Name="reviewRequestInfoBar"
                      x:FieldModifier="public"
                      x:Uid="experience"
                      IsOpen="False"
                      Visibility="Collapsed"
                      Severity="Informational"
                      Width="420"
                      Background="{ThemeResource SystemControlBaseHighAcrylicElementBrush}"
                      BorderBrush="{ThemeResource ElementBorderColor}"
                      BorderThickness="{ThemeResource ElementBorderThickness}"
                      Grid.Row="1"
                      VerticalAlignment="Bottom"
                      HorizontalAlignment="Center"
                      Margin="0, 80"
                      CloseButtonClick="OnRateNotNow_CloseButtonClick">
            <InfoBar.Content>
                <StackPanel Margin="0,-4,0,0">
                    <RichTextBlock IsTextSelectionEnabled="False">
                        <Paragraph>
                            <Run x:Uid="reviewDialog" />
                            <LineBreak />
                        </Paragraph>
                    </RichTextBlock>

                    <StackPanel Spacing="8"
                                Margin="0,-4,0,20"
                                Orientation="Horizontal">
                        <Button  x:Uid="reviewDialogOption1"
                                 Click="OnRateNowButton_Click" />
                        <Button  x:Uid="reviewDialogOption2"
                                 Click="OnRateNotNow_Click" />
                        <Button  x:Uid="reviewDialogOption3"
                                 Click="OnRateNeverShowAgain_Click" />
                    </StackPanel>
                </StackPanel>
            </InfoBar.Content>
            <animations:Implicit.ShowAnimations>
                <animations:TranslationAnimation Duration="0:0:0.5"
                                                 From="0, 35, 0"
                                                 To="0"
                                                 EasingMode="EaseOut"
                                                 EasingType="Back" />
                <animations:OpacityAnimation Duration="0:0:0.5"
                                             From="0"
                                             To="1.0" />
            </animations:Implicit.ShowAnimations>
            <animations:Implicit.HideAnimations>
                <animations:TranslationAnimation Duration="0:0:0.5"
                                                 From="0"
                                                 To="0, 35, 0"
                                                 EasingMode="EaseIn"
                                                 EasingType="Back" />
                <animations:OpacityAnimation Duration="0:0:0.5"
                                             From="1.0"
                                             To="0" />
            </animations:Implicit.HideAnimations>
            <InfoBar.IconSource>
                <FontIconSource Glyph="" />
            </InfoBar.IconSource>
        </InfoBar>

        <InfoBar x:Name="reviewRequestThankYouInfoBar"
                      x:Uid="reviewRequestThankYou"
                      x:FieldModifier="public"
                      IsOpen="False"
                      Visibility="Collapsed"
                      Severity="Success"
                      Grid.Row="1"
                      VerticalAlignment="Bottom"
                      Width="300"
                      Margin="0, 80"
                      BorderBrush="{ThemeResource ElementBorderColor}"
                      BorderThickness="{ThemeResource ElementBorderThickness}"
                      Background="{ThemeResource SystemControlBaseHighAcrylicElementBrush}">
            <InfoBar.IconSource>
                <FontIconSource Glyph="" />
            </InfoBar.IconSource>
            <animations:Implicit.ShowAnimations>
                <animations:TranslationAnimation Duration="0:0:0.5"
                                                 From="0, 35, 0"
                                                 To="0"
                                                 EasingMode="EaseOut"
                                                 EasingType="Back" />
                <animations:OpacityAnimation Duration="0:0:0.5"
                                             From="0"
                                             To="1.0" />
            </animations:Implicit.ShowAnimations>
            <animations:Implicit.HideAnimations>
                <animations:TranslationAnimation Duration="0:0:0.5"
                                                 From="0"
                                                 To="0, 35, 0"
                                                 EasingMode="EaseIn"
                                                 EasingType="Back" />
                <animations:OpacityAnimation Duration="0:0:0.5"
                                             From="1.0"
                                             To="0" />
            </animations:Implicit.HideAnimations>
        </InfoBar>

        <InfoBar x:Name="alertNotificationInfoBar"
                      x:FieldModifier="public"
                      IsOpen="False"
                      Visibility="Collapsed"
                      Severity="Error"
                      Title="N/A"
                      Width="400"
                      Background="{ThemeResource SystemControlBaseHighAcrylicElementBrush}"
                      BorderBrush="{ThemeResource ElementBorderColor}"
                      BorderThickness="{ThemeResource ElementBorderThickness}"
                      Grid.Row="1"
                      VerticalAlignment="Bottom"
                      HorizontalAlignment="Center"
                      Margin="0, 80"
                      CloseButtonClick="OnAlertNotificationInfoBar_CloseButtonClick">
            <InfoBar.Content>
                <StackPanel Margin="0,-4,0,0"
                            x:Name="alertNotificationInfoBarTextStack"
                            x:FieldModifier="public">
                    <RichTextBlock IsTextSelectionEnabled="False">
                        <Paragraph>
                            <Run x:Name="alertNotificationInfoBarText"
                                 x:FieldModifier="public">N/A</Run>
                            <LineBreak />
                        </Paragraph>
                    </RichTextBlock>
                </StackPanel>
            </InfoBar.Content>
            <animations:Implicit.ShowAnimations>
                <animations:TranslationAnimation Duration="0:0:0.5"
                                                 From="0, 35, 0"
                                                 To="0"
                                                 EasingMode="EaseOut"
                                                 EasingType="Back" />
                <animations:OpacityAnimation Duration="0:0:0.5"
                                             From="0"
                                             To="1.0" />
            </animations:Implicit.ShowAnimations>
            <animations:Implicit.HideAnimations>
                <animations:TranslationAnimation Duration="0:0:0.5"
                                                 From="0"
                                                 To="0, 35, 0"
                                                 EasingMode="EaseIn"
                                                 EasingType="Back" />
                <animations:OpacityAnimation Duration="0:0:0.5"
                                             From="1.0"
                                             To="0" />
            </animations:Implicit.HideAnimations>
        </InfoBar>
    </Grid>
</Page>
