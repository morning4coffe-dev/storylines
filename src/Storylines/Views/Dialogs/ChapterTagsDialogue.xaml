<dialogs:AppContentDialog x:Class="Storylines.Views.Dialogs.ChapterTagsDialogue"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
               xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
               xmlns:dialogs="using:Storylines.Views.Dialogs"
               xmlns:customcontrols="using:Storylines.Views.Controls"
               xmlns:controls="using:CommunityToolkit.WinUI.Controls"
               mc:Ignorable="d"
               CornerRadius="8"
               Opened="ContentDialog_Opened"
               Background="{ThemeResource DialogueAcrylicBackground}">

    <StackPanel Spacing="10"
                MinWidth="300"
                Margin="4">

        <TextBlock x:Uid="chapterTagsHeader"
                   Style="{StaticResource DialogueWindowHeaderStyle}" />

        <TextBlock x:Name="chapterNameText"
                   Opacity="0.6"
                   FontSize="12"
                   TextTrimming="CharacterEllipsis" />

        <StackPanel Spacing="4">
            <TextBlock x:Uid="chapterTagsLabel" />
            <controls:TokenizingTextBox x:Name="tagsTokenBox"
                                        x:Uid="chapterTagPlaceholder"
                                        TokenDelimiter=","
                                        MaxHeight="120"
                                        CornerRadius="6"
                                        TextChanged="OnTagsTokenBox_TextChanged"
                                        TokenItemAdded="OnTokenItem_Added"
                                        TokenItemRemoving="OnTokenItem_Removing" />
        </StackPanel>

        <TextBlock x:Uid="chapterTagsSuggestions"
                   Opacity="0.55"
                   FontSize="{StaticResource AppCaptionFontSize}" />

        <ItemsRepeater x:Name="suggestionPills"
                       Margin="0,0,0,4">
            <ItemsRepeater.Layout>
                <StackLayout Orientation="Horizontal"
                             Spacing="4"
                             x:Name="suggestionLayout" />
            </ItemsRepeater.Layout>
            <ItemsRepeater.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                    <Button Content="{x:Bind}"
                            CornerRadius="4"
                            Padding="8,2"
                            FontSize="{StaticResource AppCaptionFontSize}"
                            Click="OnSuggestionPill_Click" />
                </DataTemplate>
            </ItemsRepeater.ItemTemplate>
        </ItemsRepeater>

        <StackPanel Spacing="6">
            <TextBlock x:Uid="chapterTagsSavedPresets"
                       Opacity="0.55"
                       FontSize="{StaticResource AppCaptionFontSize}" />
            <ItemsControl x:Name="savedPresetsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Padding="8,4"
                                    CornerRadius="4"
                                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1">
                                <TextBlock Text="{x:Bind}" />
                            </Border>
                            <Button Grid.Column="1"
                                    x:Uid="chapterTagsRemovePresetButton"
                                    Margin="8,0,0,0"
                                    Padding="4"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Click="OnRemovePreset_Click"
                                    Tag="{x:Bind}">
                                <SymbolIcon Symbol="Delete" />
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock x:Name="savedPresetsEmptyText"
                       x:Uid="chapterTagsSavedPresetsEmpty"
                       Opacity="0.55"
                       FontSize="{StaticResource AppCaptionFontSize}"
                       Visibility="Collapsed" />
        </StackPanel>

        <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="8" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <customcontrols:SymbolButton x:Name="saveButton"
                                         x:Uid="chapterTagSave"
                                         Glyph="&#xE74E;"
                                         IsPrimary="True"
                                         HorizontalAlignment="Stretch"
                                         Click="OnSaveButton_Click" />
            <customcontrols:SymbolButton IsCancel="True"
                                         Grid.Column="2"
                                         HorizontalAlignment="Stretch"
                                         Click="OnCancelButton_Click" />
        </Grid>
    </StackPanel>
</dialogs:AppContentDialog>
