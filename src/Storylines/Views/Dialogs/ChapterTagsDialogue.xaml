<ContentDialog x:Class="Storylines.Views.Dialogs.ChapterTagsDialogue"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
               xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
               xmlns:customcontrols="using:Storylines.Views.Controls"
               xmlns:controls="using:Microsoft.Toolkit.Uwp.UI.Controls"
               xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
               mc:Ignorable="d"
               CornerRadius="8"
               Opened="ContentDialog_Opened"
               Closed="ContentDialog_Closed"
               Background="{ThemeResource DialogueAcrylicBackground}">

    <StackPanel Spacing="10"
                MinWidth="300"
                Margin="4">

        <TextBlock x:Uid="chapterTagsHeader"
                   Style="{StaticResource DialogueWindowHeaderStyle}" />

        <TextBlock x:Name="chapterNameText"
                   Opacity="0.6"
                   FontSize="12"
                   TextTrimming="CharacterEllipsis" />

        <StackPanel Spacing="4">
            <TextBlock x:Uid="chapterTagsLabel" />
            <controls:TokenizingTextBox x:Name="tagsTokenBox"
                                        x:Uid="chapterTagPlaceholder"
                                        TokenDelimiter=","
                                        MaxHeight="120"
                                        CornerRadius="6"
                                        TextChanged="OnTagsTokenBox_TextChanged"
                                        TokenItemAdded="OnTokenItem_Added"
                                        TokenItemRemoving="OnTokenItem_Removing" />
        </StackPanel>

        <TextBlock x:Uid="chapterTagsSuggestions"
                   Opacity="0.55"
                   FontSize="11" />

        <muxc:ItemsRepeater x:Name="suggestionPills"
                       Margin="0,0,0,4">
            <muxc:ItemsRepeater.Layout>
                <muxc:StackLayout Orientation="Horizontal"
                             Spacing="4"
                             x:Name="suggestionLayout" />
            </muxc:ItemsRepeater.Layout>
            <muxc:ItemsRepeater.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                    <Button Content="{x:Bind}"
                            CornerRadius="4"
                            Padding="8,2"
                            FontSize="11"
                            Click="OnSuggestionPill_Click" />
                </DataTemplate>
            </muxc:ItemsRepeater.ItemTemplate>
        </muxc:ItemsRepeater>

        <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="8" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <customcontrols:SymbolButton x:Name="saveButton"
                                         x:Uid="chapterTagSave"
                                         Glyph="&#xE74E;"
                                         IsPrimary="True"
                                         HorizontalAlignment="Stretch"
                                         Click="OnSaveButton_Click" />
            <customcontrols:SymbolButton IsCancel="True"
                                         Grid.Column="2"
                                         HorizontalAlignment="Stretch"
                                         Click="OnCancelButton_Click" />
        </Grid>
    </StackPanel>
</ContentDialog>
