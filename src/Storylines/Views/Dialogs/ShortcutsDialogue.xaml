<ContentDialog x:Class="Storylines.Views.Dialogs.ShortcutsDialogue"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
               xmlns:customcontrols="using:Storylines.Views.Controls"
               xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
               xmlns:helpers="using:Storylines.Helpers"
               mc:Ignorable="d"
               Closed="ContentDialog_Closed"
               CornerRadius="8"
               Background="{ThemeResource DialogueAcrylicBackground}"
               x:DefaultBindMode="OneTime">
    <ContentDialog.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/ResourceDictionaries/CustomExpanderStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentDialog.Resources>

    <Grid Width="350"
          MaxHeight="500"
          MinHeight="320"
          Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="38" />
            <RowDefinition Height="8" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="42" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Uid="shortcutsDialogueTitle"
                       Style="{StaticResource DialogueWindowHeaderStyle}"
                       FontSize="25" />

            <Button x:Name="closeButton"
                    Width="42"
                    Height="38"
                    Grid.Column="2"
                    Click="OnCloseButton_Click">
                <FontIcon Glyph=""
                          Width="23"
                          RenderTransformOrigin="-.25,.5">
                    <FontIcon.RenderTransform>
                        <CompositeTransform ScaleX=".9"
                                            ScaleY=".9" />
                    </FontIcon.RenderTransform>
                </FontIcon>
            </Button>
        </Grid>

        <ScrollViewer Grid.Row="2">
            <StackPanel Spacing="8">
                <!--Global-->
                <muxc:Expander x:Uid="shortcutsGlobalExpander"
                               Style="{StaticResource CustomExpanderStyle}"
                               HorizontalAlignment="Stretch"
                               IsExpanded="True">
                    <ItemsControl ItemsSource="{x:Bind GlobalShortcuts}"
                                  HorizontalAlignment="Stretch">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="8" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="helpers:ShortcutDefinition">
                                <customcontrols:ShortcutLineControl Description="{x:Bind Description}"
                                                                    UseControl="{x:Bind UseCtrl}"
                                                                    UseShift="{x:Bind UseShift}"
                                                                    Shortcut="{x:Bind KeyDisplayName}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </muxc:Expander>
                <!--MainPage-->
                <muxc:Expander x:Uid="shortcutsMainPageExpander"
                               Style="{StaticResource CustomExpanderStyle}"
                               HorizontalAlignment="Stretch">
                    <ItemsControl ItemsSource="{x:Bind MainPageShortcuts}"
                                  HorizontalAlignment="Stretch">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="8" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="helpers:ShortcutDefinition">
                                <customcontrols:ShortcutLineControl Description="{x:Bind Description}"
                                                                    UseControl="{x:Bind UseCtrl}"
                                                                    UseShift="{x:Bind UseShift}"
                                                                    Shortcut="{x:Bind KeyDisplayName}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </muxc:Expander>
                <!--CharactersPage-->
                <muxc:Expander x:Uid="shortcutsCharactersExpander"
                               Style="{StaticResource CustomExpanderStyle}"
                               HorizontalAlignment="Stretch">
                    <ItemsControl ItemsSource="{x:Bind CharactersPageShortcuts}"
                                  HorizontalAlignment="Stretch">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="8" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="helpers:ShortcutDefinition">
                                <customcontrols:ShortcutLineControl Description="{x:Bind Description}"
                                                                    UseControl="{x:Bind UseCtrl}"
                                                                    UseShift="{x:Bind UseShift}"
                                                                    Shortcut="{x:Bind KeyDisplayName}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </muxc:Expander>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</ContentDialog>
