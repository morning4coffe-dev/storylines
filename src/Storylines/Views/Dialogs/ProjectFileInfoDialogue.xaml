<ContentDialog x:Class="Storylines.Views.Dialogs.ProjectFileInfoDialogue"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
               mc:Ignorable="d"
               Closed="ContentDialog_Closed"
               CornerRadius="8">

    <Grid MinWidth="440"
          MaxWidth="720"
          MaxHeight="520"
          Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="42" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Uid="projectFileInfoText"
                       Style="{StaticResource DialogueWindowHeaderStyle}"
                       FontSize="20"
                       FontWeight="SemiBold" />

            <Button x:Name="closeButton"
                    Width="36"
                    Height="36"
                    Grid.Column="1"
                    Background="Transparent"
                    BorderThickness="0"
                    CornerRadius="4"
                    Click="OnCloseButton_Click">
                <SymbolIcon Symbol="Cancel" />
            </Button>
        </Grid>

        <ScrollViewer Grid.Row="2"
                      MinHeight="20">
            <Grid Background="{ThemeResource LayerFillColorDefaultBrush}"
                  CornerRadius="6"
                  Padding="16,12"
                  BorderBrush="{ThemeResource ElementBorderColor}"
                  BorderThickness="{ThemeResource ElementBorderThickness}">
                <TextBlock x:Name="projectFileInfoRun"
                           TextWrapping="Wrap"
                           LineHeight="24"
                           FontSize="13">N/A</TextBlock>
            </Grid>
        </ScrollViewer>
    </Grid>
</ContentDialog>