<ContentDialog x:Class="Storylines.Views.Dialogs.ProjectStatsDialogue"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
               xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
               mc:Ignorable="d"
               Closed="ContentDialog_Closed"
               CornerRadius="8">

    <Grid Margin="4, 0"                
          MaxHeight="550">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="42" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Uid="projectStatistics"
                       Style="{StaticResource DialogueWindowHeaderStyle}"
                       FontSize="20"
                       FontWeight="SemiBold" />

            <Button x:Name="closeButton"
                    Width="36"
                    Height="36"
                    Grid.Column="1"
                    Background="Transparent"
                    BorderThickness="0"
                    CornerRadius="4"
                    Click="OnCloseButton_Click">
                <FontIcon Glyph="&#xE711;"
                        Style="{StaticResource AppSymbolIconStyle}"
                        FontSize="{StaticResource AppCaptionFontSize}"
                        Opacity="0.6" />
            </Button>
        </Grid>

        <ScrollViewer Grid.Row="2"
                      MinHeight="20" Padding="0,0,12,0">
            <StackPanel Spacing="16">
                <!-- Current chapter section -->
                <StackPanel Spacing="4">
                    <TextBlock x:Uid="selectedChapterText"
                               Foreground="{ThemeResource SystemAccentColor}"
                               FontWeight="SemiBold"
                               FontSize="15" />
                    <Grid Background="{ThemeResource LayerFillColorDefaultBrush}"
                          CornerRadius="6"
                          Padding="16,12"
                          BorderBrush="{ThemeResource ElementBorderColor}"
                          BorderThickness="{ThemeResource ElementBorderThickness}">
                        <TextBlock x:Name="textRun"
                                   x:FieldModifier="public"
                                   TextWrapping="Wrap"
                                   LineHeight="24"
                                   FontSize="13">N/A</TextBlock>
                    </Grid>
                    <muxc:Expander HorizontalAlignment="Stretch"
                                   HorizontalContentAlignment="Stretch"
                                   IsExpanded="False"
                                   Padding="0">
                        <muxc:Expander.Header>
                            <TextBlock x:Uid="wordDistribution"
                                       FontSize="13"
                                       Opacity="0.8" />
                        </muxc:Expander.Header>
                        <muxc:Expander.Content>
                            <TextBox x:Name="wordDistributionTextBox"
                                     HorizontalAlignment="Stretch"
                                     MaxHeight="200"
                                     IsReadOnly="True"
                                     AcceptsReturn="True"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                     Text="N/A" />
                        </muxc:Expander.Content>
                    </muxc:Expander>
                </StackPanel>

                <!-- Story overview -->
                <StackPanel Spacing="4">
                    <TextBlock x:Uid="storyText"
                               Foreground="{ThemeResource SystemAccentColor}"
                               FontWeight="SemiBold"
                               FontSize="15" />
                    <Grid Background="{ThemeResource LayerFillColorDefaultBrush}"
                          CornerRadius="6"
                          Padding="16,12"
                          BorderBrush="{ThemeResource ElementBorderColor}"
                          BorderThickness="{ThemeResource ElementBorderThickness}">
                        <TextBlock x:Name="storyRun"
                                   x:FieldModifier="public"
                                   TextWrapping="Wrap"
                                   LineHeight="24"
                                   FontSize="13">N/A</TextBlock>
                    </Grid>
                </StackPanel>

                <!-- Characters + chapters row -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Uid="charactersExport"
                                   Foreground="{ThemeResource SystemAccentColor}"
                                   FontWeight="SemiBold"
                                   FontSize="15" />
                    <Grid Background="{ThemeResource LayerFillColorDefaultBrush}"
                          VerticalAlignment="Stretch"
                          CornerRadius="6"
                          Padding="16,12"
                          BorderBrush="{ThemeResource ElementBorderColor}"
                          BorderThickness="{ThemeResource ElementBorderThickness}"
                          Grid.Row="1">
                        <TextBlock x:Name="charactersRun"
                                       x:FieldModifier="public"
                                       FontSize="13">N/A</TextBlock>
                    </Grid>
                    <TextBlock x:Uid="chaptersText1"
                                Foreground="{ThemeResource SystemAccentColor}"
                                FontWeight="SemiBold"
                                FontSize="15" 
                                Grid.Column="2" />
                    <Grid Background="{ThemeResource LayerFillColorDefaultBrush}"
                              CornerRadius="6"
                              Padding="16,12"
                              BorderBrush="{ThemeResource ElementBorderColor}"
                              BorderThickness="{ThemeResource ElementBorderThickness}"
                              Grid.Column="2" Grid.Row="1">
                        <TextBlock x:Name="chaptersRun"
                                       x:FieldModifier="public"
                                       FontSize="13">N/A</TextBlock>
                    </Grid>
                </Grid>

                <!-- Chapter breakdown chart -->
                <StackPanel Spacing="4">
                    <TextBlock x:Uid="byChapterText"
                               Foreground="{ThemeResource SystemAccentColor}"
                               FontWeight="SemiBold"
                               FontSize="15" />
                    <Grid Background="{ThemeResource LayerFillColorDefaultBrush}"
                          CornerRadius="6"
                          Padding="16,12"
                          BorderBrush="{ThemeResource ElementBorderColor}"
                          BorderThickness="{ThemeResource ElementBorderThickness}">
                        <ScrollViewer MaxHeight="280"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <Canvas x:Name="chapterChartCanvas"
                                    HorizontalAlignment="Stretch" />
                        </ScrollViewer>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</ContentDialog>

