<dialogs:StorylinesShellDialog x:Class="Storylines.Views.Dialogs.ExportDialogue"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
               xmlns:dialogs="using:Storylines.Views.Dialogs"
               xmlns:animations="using:CommunityToolkit.WinUI.Animations"
               xmlns:customcontrols="using:Storylines.Views.Controls"
               xmlns:resources="using:Storylines.Resources"
               xmlns:viewModels="using:Storylines.ViewModels"
                mc:Ignorable="d"
                DialogMinWidth="360"
                DialogMaxWidth="640"
                x:DefaultBindMode="OneTime">

    <dialogs:StorylinesShellDialog.DialogBody>
        <StackPanel Spacing="16"
                    VerticalAlignment="Stretch"
                    HorizontalAlignment="Stretch">
            <StackPanel Spacing="8"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Visibility="Visible">
                <StackPanel.ChildrenTransitions>
                    <TransitionCollection>
                        <EntranceThemeTransition x:Name="chooseWhatToExportAnimation"
                                                 IsStaggeringEnabled="True"
                                                 FromVerticalOffset="30" />
                    </TransitionCollection>
                </StackPanel.ChildrenTransitions>

                <Button x:Name="chooseExportChaptersButton"
                        Style="{StaticResource DialogSelectionCardStyle}"
                        Click="OnChooseExportChaptersButton_Click">
                    <StackPanel Spacing="10">
                        <FontIcon Glyph="" />
                        <TextBlock Text="{x:Bind resources:ExportDialogue.OptionChapters}" />
                    </StackPanel>
                </Button>

                <Button x:Name="chooseExportDialoguesButton"
                        Style="{StaticResource DialogSelectionCardStyle}"
                        Click="OnChooseExportDialoguesButton_Click">
                    <StackPanel Spacing="10">
                        <FontIcon Glyph="" />
                        <TextBlock Text="{x:Bind resources:ExportDialogue.OptionDialogues}" />
                    </StackPanel>
                </Button>

                <Button x:Name="chooseExportCharactersButton"
                        Style="{StaticResource DialogSelectionCardStyle}"
                        Click="OnChooseExportCharactersButton_Click">
                    <StackPanel Spacing="10">
                        <FontIcon Glyph="" />
                        <TextBlock Text="{x:Bind resources:ExportDialogue.OptionCharacters}" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <Grid x:Name="chooseExportChaptersPanel"
                  Visibility="{x:Bind ViewModel.DetailsVisibility, Mode=OneWay}">
                <StackPanel Spacing="14">
                    <StackPanel Spacing="5">
                        <TextBlock Text="{x:Bind resources:ExportDialogue.FileName}" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="80" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="fileNameText"
                                     PlaceholderText="{x:Bind resources:ExportDialogue.FileNamePlaceholder}"
                                     HorizontalAlignment="Stretch"
                                     Height="38"
                                     Style="{StaticResource SmallTextBoxStyle}"
                                     Text="{x:Bind ViewModel.FileName, Mode=TwoWay}" />
                            <ComboBox x:Name="extensionComboBox"
                                      Grid.Column="1"
                                      ItemsSource="{x:Bind ViewModel.AvailableFormats, Mode=OneWay}"
                                      SelectedItem="{x:Bind ViewModel.SelectedFormat, Mode=TwoWay}"
                                      DisplayMemberPath="DisplayExtension"
                                      Height="38"
                                      CornerRadius="4"
                                      Width="80"
                                      VerticalAlignment="Bottom"
                                      HorizontalAlignment="Right"
                                      DropDownOpened="Flyout_Opened"
                                      DropDownClosed="Flyout_Closed" />
                        </Grid>
                        <TextBlock x:Name="nameCollisionWarning"
                                   Text="{x:Bind resources:ExportDialogue.FileNameCollisionError}"
                                   Foreground="Red"
                                   FontSize="12"
                                   TextWrapping="WrapWholeWords"
                                   Visibility="{x:Bind ViewModel.NameCollisionVisibility, Mode=OneWay}" />
                        <InfoBar IsClosable="True"
                                 IsOpen="{x:Bind ViewModel.IsErrorOpen, Mode=OneWay}"
                                 Severity="{x:Bind ViewModel.ErrorSeverity, Mode=OneWay}"
                                 Title="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                                 Visibility="{x:Bind ViewModel.ErrorVisibility, Mode=OneWay}"
                                 CloseButtonClick="OnErrorInfoBar_CloseButtonClick" />
                    </StackPanel>

                    <StackPanel Spacing="8">
                        <TextBlock Text="{x:Bind resources:ExportDialogue.FileLocation}" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="44" />
                            </Grid.ColumnDefinitions>
                            <Grid HorizontalAlignment="Stretch"
                                  Background="{x:Bind fileNameText.Background, Mode=OneWay}"
                                  CornerRadius="4"
                                  BorderThickness="1"
                                  BorderBrush="{x:Bind fileNameText.BorderBrush, Mode=OneWay}"
                                  Padding="10,0"
                                  Tapped="OnExportLocationFrame_Tapped">
                                <TextBlock x:Name="locationTextPlaceholder"
                                           Text="{x:Bind resources:ExportDialogue.FileLocationPlaceholder}"
                                           Opacity="0.8"
                                           VerticalAlignment="Center"
                                           Visibility="{x:Bind ViewModel.LocationPlaceholderVisibility, Mode=OneWay}" />
                                <TextBlock x:Name="locationText"
                                           Text="{x:Bind ViewModel.LocationPath, Mode=OneWay}"
                                           VerticalAlignment="Center"
                                           Visibility="{x:Bind ViewModel.LocationTextVisibility, Mode=OneWay}" />
                            </Grid>
                            <Button Grid.Column="1"
                                    Height="38"
                                    CornerRadius="4"
                                    Width="44"
                                    VerticalAlignment="Bottom"
                                    HorizontalAlignment="Right"
                                    Click="OnExportToLocationButton_Click">
                                <Button.Content>
                                    <FontIcon Glyph=""
                                              RenderTransformOrigin=".5,.5">
                                        <FontIcon.RenderTransform>
                                            <CompositeTransform ScaleX=".78"
                                                                ScaleY=".78" />
                                        </FontIcon.RenderTransform>
                                    </FontIcon>
                                </Button.Content>
                            </Button>
                        </Grid>
                    </StackPanel>

                    <CheckBox x:Name="withChapterNameCheckBox"
                              Content="{x:Bind resources:ExportDialogue.IncludeChapterName}"
                              IsChecked="{x:Bind ViewModel.IncludeChapterName, Mode=TwoWay}"
                              Visibility="{x:Bind ViewModel.IncludeChapterNameVisibility, Mode=OneWay}" />

                    <StackPanel Spacing="8">
                        <TextBlock x:Name="chaptersToExportText"
                                   Text="{x:Bind ViewModel.PrimarySelectionHeader, Mode=OneWay}"
                                   Visibility="{x:Bind ViewModel.PrimarySelectionVisibility, Mode=OneWay}" />
                        <DropDownButton x:Name="chaptersToExport"
                                        Height="38"
                                        Content="{x:Bind ViewModel.PrimarySelectionSummary, Mode=OneWay}"
                                        HorizontalContentAlignment="Left"
                                        CornerRadius="4"
                                        HorizontalAlignment="Stretch"
                                        Visibility="{x:Bind ViewModel.PrimarySelectionVisibility, Mode=OneWay}">
                            <DropDownButton.Flyout>
                                <Flyout Opened="Flyout_Opened"
                                        Closed="Flyout_Closed">
                                    <ListView x:Name="chaptersToExportList"
                                              Width="266"
                                              ItemsSource="{x:Bind ViewModel.PrimarySelections, Mode=OneWay}"
                                              SelectionMode="None">
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="viewModels:ExportSelectionItemViewModel">
                                                <CheckBox Content="{x:Bind DisplayName}"
                                                          IsChecked="{x:Bind IsSelected, Mode=TwoWay}" />
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </Flyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>
                    </StackPanel>

                    <StackPanel x:Name="characterDialoguesToExportHolder"
                                Spacing="8"
                                Visibility="{x:Bind ViewModel.DialogueCharacterSelectionVisibility, Mode=OneWay}">
                        <TextBlock x:Name="characterDialoguesToExportText"
                                   Text="{x:Bind resources:ExportDialogue.CharactersToExport}" />
                        <DropDownButton x:Name="characterDialoguesToExport"
                                        Height="38"
                                        Content="{x:Bind ViewModel.DialogueCharacterSelectionSummary, Mode=OneWay}"
                                        HorizontalContentAlignment="Left"
                                        CornerRadius="4"
                                        HorizontalAlignment="Stretch">
                            <DropDownButton.Flyout>
                                <Flyout Opened="Flyout_Opened"
                                        Closed="Flyout_Closed">
                                    <ListView x:Name="characterDialoguesToExportList"
                                              Width="266"
                                              ItemsSource="{x:Bind ViewModel.DialogueCharacterSelections, Mode=OneWay}"
                                              SelectionMode="None">
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="viewModels:ExportSelectionItemViewModel">
                                                <CheckBox Content="{x:Bind DisplayName}"
                                                          IsChecked="{x:Bind IsSelected, Mode=TwoWay}" />
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </Flyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>
                    </StackPanel>
                </StackPanel>
                <animations:Implicit.ShowAnimations>
                    <animations:TranslationAnimation Duration="0:0:0.65"
                                                     From="0, -10, 0"
                                                     To="0" />
                    <animations:OpacityAnimation Duration="0:0:0.65"
                                                 From="0"
                                                 To="1.0" />
                </animations:Implicit.ShowAnimations>
            </Grid>
        </StackPanel>
    </dialogs:StorylinesShellDialog.DialogBody>
</dialogs:StorylinesShellDialog>
