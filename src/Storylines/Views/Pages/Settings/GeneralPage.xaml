<Page x:Class="Storylines.Views.Pages.Settings.GeneralPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:animations="using:CommunityToolkit.WinUI.Animations"
      xmlns:constants="using:Storylines.Constants"
    mc:Ignorable="d">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/ResourceDictionaries/RightAlignedToggleSwitchStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="generalPage"
                Margin="16,16,16,24"
                Spacing="10"
                    HorizontalAlignment="Stretch"
                    MaxWidth="1000">
            <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="CompactLayout">
                <VisualState.Setters>
                    <Setter Target="generalPage.Margin"
                        Value="16,16,16,24" />
                    <Setter Target="chapterNameControlColumn.Width"
                        Value="0" />
                    <Setter Target="chapterNameStack.(Grid.Row)"
                        Value="1" />
                    <Setter Target="chapterNameStack.(Grid.Column)"
                        Value="1" />
                    <Setter Target="chapterNameStack.(Grid.ColumnSpan)"
                        Value="2" />
                    <Setter Target="chapterNameStack.HorizontalAlignment"
                        Value="Left" />
                    <Setter Target="chapterNameStack.Margin"
                        Value="0,12,0,0" />
                    <Setter Target="autosaveIntervalControlColumn.Width"
                        Value="0" />
                    <Setter Target="autosaveIntervalComboBox.(Grid.Row)"
                        Value="1" />
                    <Setter Target="autosaveIntervalComboBox.(Grid.Column)"
                        Value="1" />
                    <Setter Target="autosaveIntervalComboBox.(Grid.ColumnSpan)"
                        Value="2" />
                    <Setter Target="autosaveIntervalComboBox.HorizontalAlignment"
                        Value="Left" />
                    <Setter Target="autosaveIntervalComboBox.Margin"
                        Value="0,12,0,0" />
                    <Setter Target="dailyWordGoalControlColumn.Width"
                        Value="0" />
                    <Setter Target="dailyWordGoalNumBox.(Grid.Row)"
                        Value="1" />
                    <Setter Target="dailyWordGoalNumBox.(Grid.Column)"
                        Value="1" />
                    <Setter Target="dailyWordGoalNumBox.(Grid.ColumnSpan)"
                        Value="2" />
                    <Setter Target="dailyWordGoalNumBox.HorizontalAlignment"
                        Value="Left" />
                    <Setter Target="dailyWordGoalNumBox.Margin"
                        Value="0,12,0,0" />
                </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="WideLayout">
                <VisualState.StateTriggers>
                    <AdaptiveTrigger MinWindowWidth="{x:Bind constants:LayoutConstants.SettingsWideLayoutBreakpoint}" />
                </VisualState.StateTriggers>
                <VisualState.Setters>
                    <Setter Target="generalPage.Margin"
                        Value="32,24,32,24" />
                    <Setter Target="chapterNameControlColumn.Width"
                        Value="Auto" />
                    <Setter Target="chapterNameStack.(Grid.Row)"
                        Value="0" />
                    <Setter Target="chapterNameStack.(Grid.Column)"
                        Value="2" />
                    <Setter Target="chapterNameStack.(Grid.ColumnSpan)"
                        Value="1" />
                    <Setter Target="chapterNameStack.HorizontalAlignment"
                        Value="Right" />
                    <Setter Target="chapterNameStack.Margin"
                        Value="0" />
                    <Setter Target="autosaveIntervalControlColumn.Width"
                        Value="Auto" />
                    <Setter Target="autosaveIntervalComboBox.(Grid.Row)"
                        Value="0" />
                    <Setter Target="autosaveIntervalComboBox.(Grid.Column)"
                        Value="2" />
                    <Setter Target="autosaveIntervalComboBox.(Grid.ColumnSpan)"
                        Value="1" />
                    <Setter Target="autosaveIntervalComboBox.HorizontalAlignment"
                        Value="Right" />
                    <Setter Target="autosaveIntervalComboBox.Margin"
                        Value="0" />
                    <Setter Target="dailyWordGoalControlColumn.Width"
                        Value="Auto" />
                    <Setter Target="dailyWordGoalNumBox.(Grid.Row)"
                        Value="0" />
                    <Setter Target="dailyWordGoalNumBox.(Grid.Column)"
                        Value="2" />
                    <Setter Target="dailyWordGoalNumBox.(Grid.ColumnSpan)"
                        Value="1" />
                    <Setter Target="dailyWordGoalNumBox.HorizontalAlignment"
                        Value="Right" />
                    <Setter Target="dailyWordGoalNumBox.Margin"
                        Value="0" />
                </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <TextBlock x:Uid="generalText"
                       FontSize="25"
                       Margin="0,-5,0,5"
                       FontWeight="SemiBold" />
            <Grid Background="{ThemeResource LayerFillColorDefaultBrush}"
                  BorderBrush="{ThemeResource ElementBorderColor}"
                  BorderThickness="{ThemeResource ElementBorderThickness}"
                  CornerRadius="4"
              Padding="16,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                <ColumnDefinition Width="56" />
                    <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="chapterNameControlColumn"
                          Width="Auto" />
                </Grid.ColumnDefinitions>
            <SymbolIcon Symbol="Edit"
                    VerticalAlignment="Center" />
            <StackPanel VerticalAlignment="Center"
                            Spacing="1"
                            Grid.Column="1">
                    <TextBlock x:Uid="chapterNameSetting"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center" />
                    <TextBlock x:Uid="chapterNameSettingDesc"
                               FontWeight="Light"
                               Opacity="0.8"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,0,10,0" />
                </StackPanel>

                <StackPanel x:Name="chapterNameStack"
                            Grid.Column="2"
                            Spacing="6"
                            Orientation="Horizontal"
                        HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <TextBox x:Name="chapterNameBox"
                             Width="150"
                             Height="32"
                         Text="{x:Bind ViewModel.ChapterName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <Button HorizontalAlignment="Right"
                        Command="{x:Bind ViewModel.ResetChapterNameCommand}">
                        <FontIcon Glyph=""
                                  RenderTransformOrigin="0.5,0.5">
                            <FontIcon.RenderTransform>
                                <CompositeTransform ScaleX="0.7"
                                                    ScaleY="0.7" />
                            </FontIcon.RenderTransform>
                        </FontIcon>
                    </Button>
                </StackPanel>
            </Grid>
            <StackPanel>
                <TextBlock x:Uid="projectSetting"
                           FontWeight="SemiBold"
                           Margin="0,10,0,5" />
            </StackPanel>

            <Grid Background="{ThemeResource LayerFillColorDefaultBrush}"
                  BorderBrush="{ThemeResource ElementBorderColor}"
                  BorderThickness="{ThemeResource ElementBorderThickness}"
                  CornerRadius="4"
                                    Padding="16,15">
                <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="56" />
                    <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph=""
                                                    VerticalAlignment="Center"
                          HorizontalAlignment="Center" />
                <TextBlock x:Uid="unsavedProgressAlert"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           Grid.Column="1" />
                <ToggleSwitch x:Name="exitDialogueToggleSwitch"
                              Style="{StaticResource RightAlignedToggleSwitchStyle}"
                              HorizontalAlignment="Right"
                              Grid.Column="2"
                              IsOn="{x:Bind ViewModel.ExitDialogueEnabled, Mode=TwoWay}" />
            </Grid>

            <Grid Background="{ThemeResource LayerFillColorDefaultBrush}"
                  BorderBrush="{ThemeResource ElementBorderColor}"
                  BorderThickness="{ThemeResource ElementBorderThickness}"
                  CornerRadius="4"
                                    Padding="16,15">
                <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="56" />
                    <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph=""
                                                    VerticalAlignment="Center"
                          HorizontalAlignment="Center" />
                <StackPanel VerticalAlignment="Center"
                            Spacing="1"
                            Grid.Column="1">
                    <TextBlock x:Uid="projectOnStartSetting"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center" />
                    <TextBlock x:Uid="projectOnStartSettingDesc"
                               FontWeight="Light"
                               Opacity="0.8"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,0,10,0" />
                </StackPanel>
                <ToggleSwitch x:Name="projectOnStartToggleSwitch"
                              Style="{StaticResource RightAlignedToggleSwitchStyle}"
                              HorizontalAlignment="Right"
                              Grid.Column="2"
                              IsOn="{x:Bind ViewModel.LoadLastProjectOnStart, Mode=TwoWay}" />
            </Grid>

            <StackPanel>
                <TextBlock x:Uid="autosaveText"
                           FontWeight="SemiBold"
                           Margin="0,10,0,5" />
            </StackPanel>

            <Grid Background="{ThemeResource LayerFillColorDefaultBrush}"
                  BorderBrush="{ThemeResource ElementBorderColor}"
                  BorderThickness="{ThemeResource ElementBorderThickness}"
                  CornerRadius="4"
                                    Padding="16,15">
                <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="56" />
                    <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph=""
                                                    VerticalAlignment="Center"
                          HorizontalAlignment="Center" />
                <TextBlock x:Uid="autosaveEnable"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           Grid.Column="1" />
                <ToggleSwitch x:Name="autosaveToggleSwitch"
                              Style="{StaticResource RightAlignedToggleSwitchStyle}"
                              HorizontalAlignment="Right"
                              Grid.Column="2"
                              IsOn="{x:Bind ViewModel.AutosaveEnabled, Mode=TwoWay}" />
            </Grid>

            <Grid Background="{ThemeResource LayerFillColorDefaultBrush}"
                  BorderBrush="{ThemeResource ElementBorderColor}"
                  BorderThickness="{ThemeResource ElementBorderThickness}"
                  CornerRadius="4"
                  Padding="16,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="56" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="autosaveIntervalControlColumn"
                                      Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph=""
                          VerticalAlignment="Center"
                          HorizontalAlignment="Center" />
                <TextBlock x:Uid="autosaveInterval"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           Grid.Column="1" />
                <ComboBox x:Name="autosaveIntervalComboBox"
                          HorizontalAlignment="Right"
                          HorizontalContentAlignment="Left"
                          VerticalAlignment="Center"
                          Height="30"
                          Width="120"
                          Grid.Column="2"
                          MinWidth="120"
                          SelectedValuePath="Tag"
                          SelectedValue="{x:Bind ViewModel.AutosaveIntervalKey, Mode=TwoWay}">
                    <ComboBox.Items>
                        <ComboBoxItem x:Uid="autosaveInterval1"
                                      Tag="0.5" />
                        <ComboBoxItem x:Uid="autosaveInterval2"
                                      Tag="2" />
                        <ComboBoxItem x:Uid="autosaveInterval5"
                                      Tag="5" />
                        <ComboBoxItem x:Uid="autosaveInterval10"
                                      Tag="10" />
                        <ComboBoxItem x:Uid="autosaveInterval12"
                                      Tag="12" />
                        <ComboBoxItem x:Uid="autosaveInterval15"
                                      Tag="15" />
                        <ComboBoxItem x:Uid="autosaveInterval30"
                                      Tag="30" />
                        <ComboBoxItem x:Uid="autosaveInterval60"
                                      Tag="60" />
                    </ComboBox.Items>
                </ComboBox>
            </Grid>

            <StackPanel>
                <TextBlock x:Uid="writingGoalSetting"
                           FontWeight="SemiBold"
                           Margin="0,10,0,5" />
            </StackPanel>

            <Grid Background="{ThemeResource LayerFillColorDefaultBrush}"
                  BorderBrush="{ThemeResource ElementBorderColor}"
                  BorderThickness="{ThemeResource ElementBorderThickness}"
                  CornerRadius="4"
                  Padding="16,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="56" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="dailyWordGoalControlColumn"
                                      Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE8EF;"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Center" />
                <StackPanel VerticalAlignment="Center"
                            Spacing="1"
                            Grid.Column="1">
                    <TextBlock x:Uid="dailyWordGoalSetting"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center" />
                    <TextBlock x:Uid="dailyWordGoalSettingDesc"
                               FontWeight="Light"
                               Opacity="0.8"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,0,10,0" />
                </StackPanel>
                <NumberBox x:Name="dailyWordGoalNumBox"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Minimum="0"
                                Maximum="10000"
                                SmallChange="50"
                                LargeChange="500"
                                SpinButtonPlacementMode="Compact"
                                Width="120"
                                MinWidth="120"
                                Height="30"
                                Grid.Column="2"
                                Value="{x:Bind ViewModel.DailyWordGoal, Mode=TwoWay}" />
            </Grid>

            <StackPanel>
                <TextBlock x:Uid="experimentalSetting"
                           FontWeight="SemiBold"
                           Margin="0,10,0,5" />
            </StackPanel>

            <Grid Background="{ThemeResource LayerFillColorDefaultBrush}"
                  BorderBrush="{ThemeResource ElementBorderColor}"
                  BorderThickness="{ThemeResource ElementBorderThickness}"
                  CornerRadius="4"
                                    Padding="16,15">
                <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="56" />
                    <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE9D9;"
                                                    VerticalAlignment="Center"
                          HorizontalAlignment="Center" />
                <StackPanel VerticalAlignment="Center"
                            Spacing="1"
                            Grid.Column="1">
                    <TextBlock x:Uid="experimentalFeaturesToggle"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center" />
                    <TextBlock x:Uid="experimentalFeaturesToggleDesc"
                               FontWeight="Light"
                               Opacity="0.8"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,0,10,0" />
                </StackPanel>
                <ToggleSwitch x:Name="experimentalFeaturesToggleSwitch"
                              Style="{StaticResource RightAlignedToggleSwitchStyle}"
                              HorizontalAlignment="Right"
                              Grid.Column="2"
                              IsOn="{x:Bind ViewModel.ExperimentalFeaturesEnabled, Mode=TwoWay}" />
            </Grid>

        </StackPanel>
    </ScrollViewer>
</Page>
