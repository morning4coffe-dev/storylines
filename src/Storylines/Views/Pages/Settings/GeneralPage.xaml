<Page x:Class="Storylines.Views.Pages.Settings.GeneralPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:controls="using:Storylines.Views.Controls"
      mc:Ignorable="d">

    <controls:SettingsPageLayout>
        <StackPanel Spacing="10">

            <TextBlock x:Uid="generalText"
                       FontSize="25"
                       Margin="0,-5,0,5"
                       FontWeight="SemiBold" />

            <!-- Chapter name -->
            <controls:SettingsCard Glyph="&#xE104;">
                <controls:SettingsCard.Header>
                    <TextBlock x:Uid="chapterNameSetting" TextWrapping="Wrap" />
                </controls:SettingsCard.Header>
                <controls:SettingsCard.Description>
                    <TextBlock x:Uid="chapterNameSettingDesc" TextWrapping="Wrap" />
                </controls:SettingsCard.Description>
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBox Width="150"
                             Height="32"
                             Text="{x:Bind ViewModel.ChapterName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Command="{x:Bind ViewModel.ResetChapterNameCommand}">
                        <FontIcon Glyph="&#xE149;"
                                  RenderTransformOrigin="0.5,0.5">
                            <FontIcon.RenderTransform>
                                <CompositeTransform ScaleX="0.7" ScaleY="0.7" />
                            </FontIcon.RenderTransform>
                        </FontIcon>
                    </Button>
                </StackPanel>
            </controls:SettingsCard>

            <!-- Project section -->
            <TextBlock x:Uid="projectSetting"
                       FontWeight="SemiBold"
                       Margin="0,10,0,5" />

            <controls:SettingsCard Glyph="&#xEA18;">
                <controls:SettingsCard.Header>
                    <TextBlock x:Uid="unsavedProgressAlert" TextWrapping="Wrap" />
                </controls:SettingsCard.Header>
                <ToggleSwitch Style="{StaticResource RightAlignedToggleSwitchStyle}"
                              IsOn="{x:Bind ViewModel.ExitDialogueEnabled, Mode=TwoWay}" />
            </controls:SettingsCard>

            <controls:SettingsCard Glyph="&#xE8E5;">
                <controls:SettingsCard.Header>
                    <TextBlock x:Uid="projectOnStartSetting" TextWrapping="Wrap" />
                </controls:SettingsCard.Header>
                <controls:SettingsCard.Description>
                    <TextBlock x:Uid="projectOnStartSettingDesc" TextWrapping="Wrap" />
                </controls:SettingsCard.Description>
                <ToggleSwitch Style="{StaticResource RightAlignedToggleSwitchStyle}"
                              IsOn="{x:Bind ViewModel.LoadLastProjectOnStart, Mode=TwoWay}" />
            </controls:SettingsCard>

            <!-- Autosave section -->
            <TextBlock x:Uid="autosaveText"
                       FontWeight="SemiBold"
                       Margin="0,10,0,5" />

            <controls:SettingsCard Glyph="&#xE74E;">
                <controls:SettingsCard.Header>
                    <TextBlock x:Uid="autosaveEnable" TextWrapping="Wrap" />
                </controls:SettingsCard.Header>
                <ToggleSwitch Style="{StaticResource RightAlignedToggleSwitchStyle}"
                              IsOn="{x:Bind ViewModel.AutosaveEnabled, Mode=TwoWay}" />
            </controls:SettingsCard>

            <controls:SettingsCard Glyph="&#xE823;">
                <controls:SettingsCard.Header>
                    <TextBlock x:Uid="autosaveInterval" TextWrapping="Wrap" />
                </controls:SettingsCard.Header>
                <ComboBox HorizontalContentAlignment="Left"
                          VerticalAlignment="Center"
                          Height="30"
                          Width="120"
                          MinWidth="120"
                          SelectedValuePath="Tag"
                          SelectedValue="{x:Bind ViewModel.AutosaveIntervalKey, Mode=TwoWay}">
                    <ComboBox.Items>
                        <ComboBoxItem x:Uid="autosaveInterval1" Tag="0.5" />
                        <ComboBoxItem x:Uid="autosaveInterval2" Tag="2" />
                        <ComboBoxItem x:Uid="autosaveInterval5" Tag="5" />
                        <ComboBoxItem x:Uid="autosaveInterval10" Tag="10" />
                        <ComboBoxItem x:Uid="autosaveInterval12" Tag="12" />
                        <ComboBoxItem x:Uid="autosaveInterval15" Tag="15" />
                        <ComboBoxItem x:Uid="autosaveInterval30" Tag="30" />
                        <ComboBoxItem x:Uid="autosaveInterval60" Tag="60" />
                    </ComboBox.Items>
                </ComboBox>
            </controls:SettingsCard>

            <!-- Writing goal section -->
            <TextBlock x:Uid="writingGoalSetting"
                       FontWeight="SemiBold"
                       Margin="0,10,0,5" />

            <controls:SettingsCard Glyph="&#xE8EF;">
                <controls:SettingsCard.Header>
                    <TextBlock x:Uid="dailyWordGoalSetting" TextWrapping="Wrap" />
                </controls:SettingsCard.Header>
                <controls:SettingsCard.Description>
                    <TextBlock x:Uid="dailyWordGoalSettingDesc" TextWrapping="Wrap" />
                </controls:SettingsCard.Description>
                <NumberBox Minimum="0"
                           Maximum="10000"
                           SmallChange="50"
                           LargeChange="500"
                           SpinButtonPlacementMode="Compact"
                           Width="120"
                           MinWidth="120"
                           Height="30"
                           Value="{x:Bind ViewModel.DailyWordGoal, Mode=TwoWay}" />
            </controls:SettingsCard>

            <!-- Experimental section -->
            <TextBlock x:Uid="experimentalSetting"
                       FontWeight="SemiBold"
                       Margin="0,10,0,5" />

            <controls:SettingsCard Glyph="&#xE9D9;">
                <controls:SettingsCard.Header>
                    <TextBlock x:Uid="experimentalFeaturesToggle" TextWrapping="Wrap" />
                </controls:SettingsCard.Header>
                <controls:SettingsCard.Description>
                    <TextBlock x:Uid="experimentalFeaturesToggleDesc" TextWrapping="Wrap" />
                </controls:SettingsCard.Description>
                <ToggleSwitch Style="{StaticResource RightAlignedToggleSwitchStyle}"
                              IsOn="{x:Bind ViewModel.ExperimentalFeaturesEnabled, Mode=TwoWay}" />
            </controls:SettingsCard>

        </StackPanel>
    </controls:SettingsPageLayout>
</Page>
