<Page x:Class="Storylines.Views.Pages.Settings.PersonalizationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    mc:Ignorable="d">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/ResourceDictionaries/RightAlignedToggleSwitchStyle.xaml" />
                <ResourceDictionary Source="/Resources/ResourceDictionaries/CustomExpanderStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="personalizationPage"
                Margin="16,16,16,24"
                Spacing="10"
                    HorizontalAlignment="Stretch"
                    MaxWidth="1000">
            <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="CompactLayout">
                <VisualState.Setters>
                    <Setter Target="personalizationPage.Margin"
                        Value="16,16,16,24" />
                    <Setter Target="themeControlColumn.Width"
                        Value="0" />
                    <Setter Target="themeComboBox.(Grid.Row)"
                        Value="1" />
                    <Setter Target="themeComboBox.(Grid.Column)"
                        Value="1" />
                    <Setter Target="themeComboBox.(Grid.ColumnSpan)"
                        Value="2" />
                    <Setter Target="themeComboBox.HorizontalAlignment"
                        Value="Left" />
                    <Setter Target="themeComboBox.Margin"
                        Value="0,12,0,0" />
                    <Setter Target="accentControlColumn.Width"
                        Value="0" />
                    <Setter Target="accentComboBox.(Grid.Row)"
                        Value="1" />
                    <Setter Target="accentComboBox.(Grid.Column)"
                        Value="1" />
                    <Setter Target="accentComboBox.(Grid.ColumnSpan)"
                        Value="2" />
                    <Setter Target="accentComboBox.HorizontalAlignment"
                        Value="Left" />
                    <Setter Target="accentComboBox.Margin"
                        Value="0,12,0,0" />
                    <Setter Target="fontFamilyControlColumn.Width"
                        Value="0" />
                    <Setter Target="fontFamilyComboBox.(Grid.Row)"
                        Value="1" />
                    <Setter Target="fontFamilyComboBox.(Grid.Column)"
                        Value="1" />
                    <Setter Target="fontFamilyComboBox.(Grid.ColumnSpan)"
                        Value="2" />
                    <Setter Target="fontFamilyComboBox.HorizontalAlignment"
                        Value="Left" />
                    <Setter Target="fontFamilyComboBox.Margin"
                        Value="0,12,0,0" />
                    <Setter Target="fontSizeControlColumn.Width"
                        Value="0" />
                    <Setter Target="fontSizeNumBox.(Grid.Row)"
                        Value="1" />
                    <Setter Target="fontSizeNumBox.(Grid.Column)"
                        Value="1" />
                    <Setter Target="fontSizeNumBox.(Grid.ColumnSpan)"
                        Value="2" />
                    <Setter Target="fontSizeNumBox.HorizontalAlignment"
                        Value="Left" />
                    <Setter Target="fontSizeNumBox.Margin"
                        Value="0,12,0,0" />
                    <Setter Target="zoomControlColumn.Width"
                        Value="0" />
                    <Setter Target="editorZoomStack.(Grid.Row)"
                        Value="1" />
                    <Setter Target="editorZoomStack.(Grid.Column)"
                        Value="1" />
                    <Setter Target="editorZoomStack.(Grid.ColumnSpan)"
                        Value="2" />
                    <Setter Target="editorZoomStack.HorizontalAlignment"
                        Value="Left" />
                    <Setter Target="editorZoomStack.Margin"
                        Value="0,12,0,0" />
                </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="WideLayout">
                <VisualState.StateTriggers>
                    <AdaptiveTrigger MinWindowWidth="1400" />
                </VisualState.StateTriggers>
                <VisualState.Setters>
                    <Setter Target="personalizationPage.Margin"
                        Value="32,24,32,24" />
                    <Setter Target="themeControlColumn.Width"
                        Value="Auto" />
                    <Setter Target="themeComboBox.(Grid.Row)"
                        Value="0" />
                    <Setter Target="themeComboBox.(Grid.Column)"
                        Value="2" />
                    <Setter Target="themeComboBox.(Grid.ColumnSpan)"
                        Value="1" />
                    <Setter Target="themeComboBox.HorizontalAlignment"
                        Value="Right" />
                    <Setter Target="themeComboBox.Margin"
                        Value="0" />
                    <Setter Target="accentControlColumn.Width"
                        Value="Auto" />
                    <Setter Target="accentComboBox.(Grid.Row)"
                        Value="0" />
                    <Setter Target="accentComboBox.(Grid.Column)"
                        Value="2" />
                    <Setter Target="accentComboBox.(Grid.ColumnSpan)"
                        Value="1" />
                    <Setter Target="accentComboBox.HorizontalAlignment"
                        Value="Right" />
                    <Setter Target="accentComboBox.Margin"
                        Value="0" />
                    <Setter Target="fontFamilyControlColumn.Width"
                        Value="Auto" />
                    <Setter Target="fontFamilyComboBox.(Grid.Row)"
                        Value="0" />
                    <Setter Target="fontFamilyComboBox.(Grid.Column)"
                        Value="2" />
                    <Setter Target="fontFamilyComboBox.(Grid.ColumnSpan)"
                        Value="1" />
                    <Setter Target="fontFamilyComboBox.HorizontalAlignment"
                        Value="Right" />
                    <Setter Target="fontFamilyComboBox.Margin"
                        Value="0" />
                    <Setter Target="fontSizeControlColumn.Width"
                        Value="Auto" />
                    <Setter Target="fontSizeNumBox.(Grid.Row)"
                        Value="0" />
                    <Setter Target="fontSizeNumBox.(Grid.Column)"
                        Value="2" />
                    <Setter Target="fontSizeNumBox.(Grid.ColumnSpan)"
                        Value="1" />
                    <Setter Target="fontSizeNumBox.HorizontalAlignment"
                        Value="Right" />
                    <Setter Target="fontSizeNumBox.Margin"
                        Value="0" />
                    <Setter Target="zoomControlColumn.Width"
                        Value="Auto" />
                    <Setter Target="editorZoomStack.(Grid.Row)"
                        Value="0" />
                    <Setter Target="editorZoomStack.(Grid.Column)"
                        Value="2" />
                    <Setter Target="editorZoomStack.(Grid.ColumnSpan)"
                        Value="1" />
                    <Setter Target="editorZoomStack.HorizontalAlignment"
                        Value="Right" />
                    <Setter Target="editorZoomStack.Margin"
                        Value="0" />
                </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <TextBlock x:Uid="personalizationText"
                       FontSize="25"
                       Margin="0,-5,0,5"
                       FontWeight="SemiBold" />

            <Grid Background="{ThemeResource LayerFillColorDefaultBrush}"
                  BorderBrush="{ThemeResource ElementBorderColor}"
                  BorderThickness="{ThemeResource ElementBorderThickness}"
                  CornerRadius="4"
              Padding="16,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                <ColumnDefinition Width="56" />
                    <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="themeControlColumn"
                          Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph=""
                          Style="{StaticResource AppSymbolIconStyle}"
                  VerticalAlignment="Center"
                          HorizontalAlignment="Center" />
                <TextBlock x:Uid="chooseThemeSetting"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           Grid.Column="1" />
                <ComboBox x:Name="themeComboBox"
                          HorizontalAlignment="Right"
                          HorizontalContentAlignment="Left"
                          VerticalAlignment="Center"
                          Height="30"
                          Width="120"
                          MinWidth="120"
                          Grid.Column="2"
                          SelectedIndex="{x:Bind ViewModel.SelectedThemeIndex, Mode=TwoWay}">
                    <ComboBox.Items>
                        <ComboBoxItem x:Uid="light" />
                        <ComboBoxItem x:Uid="dark" />
                        <ComboBoxItem x:Uid="system" />
                    </ComboBox.Items>
                </ComboBox>
            </Grid>

            <muxc:Expander Style="{StaticResource CustomExpanderStyle}"
                           BorderBrush="{ThemeResource LayerFillColorDefaultBrush}"
                           BorderThickness="{ThemeResource ElementBorderThickness}"
                           HorizontalAlignment="Stretch"
                           VerticalAlignment="Top"
                           HorizontalContentAlignment="Left"
                           IsExpanded="True">
                <muxc:Expander.Header>
                    <Grid Padding="-15,20,-12,20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="56" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition x:Name="accentControlColumn"
                                              Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph=""
                                  Style="{StaticResource AppSymbolIconStyle}"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Center" />
                        <TextBlock x:Uid="chooseAccentColorSetting"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"
                                   Grid.Column="1" />
                        <ComboBox x:Name="accentComboBox"
                                  HorizontalAlignment="Right"
                                  HorizontalContentAlignment="Left"
                                  VerticalAlignment="Center"
                                  Height="30"
                                  Width="120"
                                                                    MinWidth="120"
                                  Grid.Column="2"
                                                                    SelectedIndex="{x:Bind ViewModel.SelectedAccentIndex, Mode=TwoWay}">
                            <ComboBox.Items>
                                <ComboBoxItem x:Uid="system" />
                                <ComboBoxItem x:Uid="app" />
                                <ComboBoxItem x:Uid="custom" />
                            </ComboBox.Items>
                        </ComboBox>
                    </Grid>
                </muxc:Expander.Header>
                <muxc:Expander.Content>
                    <StackPanel Spacing="12"
                                Margin="16,12">
                        <TextBlock x:Uid="quickPresets"
                                   FontWeight="Medium"
                                   FontSize="13"
                                   Opacity="0.8" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Uid="accentPresetOrange" Tag="#BE5A00" Width="38" Height="38" CornerRadius="19"
                                    Padding="0"
                                    Command="{x:Bind ViewModel.ApplyAccentPresetCommand}"
                                    CommandParameter="#BE5A00">
                                <Ellipse Fill="#BE5A00" Width="36" Height="36" />
                            </Button>
                            <Button x:Uid="accentPresetBlue" Tag="#0078D4" Width="38" Height="38" CornerRadius="19"
                                    Padding="0"
                                    Command="{x:Bind ViewModel.ApplyAccentPresetCommand}"
                                    CommandParameter="#0078D4">
                                <Ellipse Fill="#0078D4" Width="36" Height="36" />
                            </Button>
                            <Button x:Uid="accentPresetGreen" Tag="#107C10" Width="38" Height="38" CornerRadius="19"
                                    Padding="0"
                                    Command="{x:Bind ViewModel.ApplyAccentPresetCommand}"
                                    CommandParameter="#107C10">
                                <Ellipse Fill="#107C10" Width="36" Height="36" />
                            </Button>
                            <Button x:Uid="accentPresetRed" Tag="#E81123" Width="38" Height="38" CornerRadius="19"
                                    Padding="0"
                                    Command="{x:Bind ViewModel.ApplyAccentPresetCommand}"
                                    CommandParameter="#E81123">
                                <Ellipse Fill="#E81123" Width="36" Height="36" />
                            </Button>
                            <Button x:Uid="accentPresetPurple" Tag="#881798" Width="38" Height="38" CornerRadius="19"
                                    Padding="0"
                                    Command="{x:Bind ViewModel.ApplyAccentPresetCommand}"
                                    CommandParameter="#881798">
                                <Ellipse Fill="#881798" Width="36" Height="36" />
                            </Button>
                            <Button x:Uid="accentPresetRust" Tag="#CA5010" Width="38" Height="38" CornerRadius="19"
                                    Padding="0"
                                    Command="{x:Bind ViewModel.ApplyAccentPresetCommand}"
                                    CommandParameter="#CA5010">
                                <Ellipse Fill="#CA5010" Width="36" Height="36" />
                            </Button>
                        </StackPanel>
                        <ColorPicker x:Name="customAccentPicker"
                                     HorizontalAlignment="Left"
                                     ColorSpectrumShape="Ring"
                                     IsMoreButtonVisible="False"
                                     IsColorSliderVisible="True"
                                     IsColorChannelTextInputVisible="True"
                                     IsHexInputVisible="True"
                                     IsAlphaEnabled="False"
                                     IsEnabled="{x:Bind ViewModel.IsCustomAccentSelected, Mode=OneWay}"
                                     Color="{x:Bind ViewModel.CustomAccentColor, Mode=TwoWay}" />
                    </StackPanel>
                </muxc:Expander.Content>
            </muxc:Expander>

            <Grid Background="{ThemeResource LayerFillColorDefaultBrush}"
                  BorderBrush="{ThemeResource ElementBorderColor}"
                  BorderThickness="{ThemeResource ElementBorderThickness}"
                  CornerRadius="4"
                                    Padding="16,15">
                <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="56" />
                    <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph=""
                          Style="{StaticResource AppSymbolIconStyle}"
                                                    VerticalAlignment="Center"
                          HorizontalAlignment="Center" />
                <StackPanel VerticalAlignment="Center"
                            Spacing="1"
                            Grid.Column="1">
                    <TextBlock x:Uid="newChapterShortcut"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap" />
                    <TextBlock x:Uid="newChapterShortcutDesc"
                               FontWeight="Light"
                               Opacity="0.8"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,0,10,0" />
                </StackPanel>
                <ToggleSwitch x:Name="addChapterOnPageDownToggleSwitch"
                              Style="{StaticResource RightAlignedToggleSwitchStyle}"
                              HorizontalAlignment="Right"
                              Grid.Column="2"
                              IsOn="{x:Bind ViewModel.AddChapterOnPageDownEnabled, Mode=TwoWay}" />
            </Grid>

            <StackPanel>
                <TextBlock x:Uid="textEditorSetting"
                           FontWeight="SemiBold"
                           Margin="0,10,0,5" />
            </StackPanel>

            <Grid Background="{ThemeResource LayerFillColorDefaultBrush}"
                  BorderBrush="{ThemeResource ElementBorderColor}"
                  BorderThickness="{ThemeResource ElementBorderThickness}"
                  CornerRadius="4"
                  Padding="16,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="56" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="fontFamilyControlColumn"
                                      Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE8D2;"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Center" />
                <StackPanel VerticalAlignment="Center"
                            Spacing="1"
                            Grid.Column="1">
                    <TextBlock x:Uid="editorFontFamilySetting"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap" />
                    <TextBlock x:Uid="editorFontFamilySettingDesc"
                               FontWeight="Light"
                               Opacity="0.8"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,0,10,0" />
                </StackPanel>
                <ComboBox x:Name="fontFamilyComboBox"
                          HorizontalAlignment="Right"
                          HorizontalContentAlignment="Left"
                          VerticalAlignment="Center"
                          Height="30"
                          Width="160"
                          MinWidth="160"
                          Grid.Column="2"
                          SelectedValuePath="Tag"
                          SelectedValue="{x:Bind ViewModel.EditorFontFamily, Mode=TwoWay}">
                    <ComboBoxItem Content="Calibri" Tag="Calibri" />
                    <ComboBoxItem Content="Cambria" Tag="Cambria" />
                    <ComboBoxItem Content="Georgia" Tag="Georgia" />
                    <ComboBoxItem Content="Times New Roman" Tag="Times New Roman" />
                    <ComboBoxItem Content="Arial" Tag="Arial" />
                    <ComboBoxItem Content="Segoe UI" Tag="Segoe UI" />
                    <ComboBoxItem Content="Verdana" Tag="Verdana" />
                    <ComboBoxItem Content="Garamond" Tag="Garamond" />
                    <ComboBoxItem Content="Palatino Linotype" Tag="Palatino Linotype" />
                </ComboBox>
            </Grid>

            <Grid Background="{ThemeResource LayerFillColorDefaultBrush}"
                  BorderBrush="{ThemeResource ElementBorderColor}"
                  BorderThickness="{ThemeResource ElementBorderThickness}"
                  CornerRadius="4"
                  Padding="16,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="56" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="fontSizeControlColumn"
                                      Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE8D2;"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Center" />
                <TextBlock x:Uid="editorFontSizeSetting"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           Grid.Column="1" />
                <muxc:NumberBox x:Name="fontSizeNumBox"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Minimum="8"
                                Maximum="24"
                                SmallChange="1"
                                SpinButtonPlacementMode="Compact"
                                Width="100"
                                MinWidth="100"
                                Height="30"
                                Grid.Column="2"
                                Value="{x:Bind ViewModel.EditorFontSize, Mode=TwoWay}" />
            </Grid>

            <Grid Background="{ThemeResource LayerFillColorDefaultBrush}"
                  BorderBrush="{ThemeResource ElementBorderColor}"
                  BorderThickness="{ThemeResource ElementBorderThickness}"
                  CornerRadius="4"
                  Padding="16,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="56" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="zoomControlColumn"
                                      Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE71E;"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Center" />
                <TextBlock x:Uid="zoom"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           Grid.Column="1" />
                <StackPanel x:Name="editorZoomStack"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Right"
                            Grid.Column="2">
                    <muxc:NumberBox x:Name="editorZoomNumBox"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Minimum="52"
                                    Maximum="400"
                                    SmallChange="10"
                                    SpinButtonPlacementMode="Compact"
                                    Width="100"
                                    MinWidth="100"
                                    Height="30"
                                    Value="{x:Bind ViewModel.EditorZoomPercent, Mode=TwoWay}" />
                    <TextBlock Text="%"
                               VerticalAlignment="Center"
                               Opacity="0.8" />
                </StackPanel>
            </Grid>

            <StackPanel.ChildrenTransitions>
                <TransitionCollection>
                    <EntranceThemeTransition IsStaggeringEnabled="True"
                                             FromVerticalOffset="50" />
                </TransitionCollection>
            </StackPanel.ChildrenTransitions>
        </StackPanel>
    </ScrollViewer>
</Page>
