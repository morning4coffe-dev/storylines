<Page x:Class="Storylines.Views.Pages.Settings.PersonalizationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:controls="using:Storylines.Views.Controls"
      mc:Ignorable="d">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/ResourceDictionaries/CustomExpanderStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <controls:SettingsPageLayout>
        <StackPanel Spacing="10">

            <TextBlock x:Uid="personalizationText"
                       FontSize="25"
                       Margin="0,-5,0,5"
                       FontWeight="SemiBold" />

            <!-- Theme -->
            <controls:SettingsCard Glyph="&#xE790;">
                <controls:SettingsCard.Header>
                    <TextBlock x:Uid="chooseThemeSetting" TextWrapping="Wrap" />
                </controls:SettingsCard.Header>
                <ComboBox HorizontalContentAlignment="Left"
                          VerticalAlignment="Center"
                          Height="30"
                          Width="120"
                          MinWidth="120"
                          SelectedIndex="{x:Bind ViewModel.SelectedThemeIndex, Mode=TwoWay}">
                    <ComboBox.Items>
                        <ComboBoxItem x:Uid="light" />
                        <ComboBoxItem x:Uid="dark" />
                        <ComboBoxItem x:Uid="system" />
                    </ComboBox.Items>
                </ComboBox>
            </controls:SettingsCard>

            <!-- Accent color (Expander) -->
            <Expander Style="{StaticResource CustomExpanderStyle}"
                      BorderBrush="{ThemeResource LayerFillColorDefaultBrush}"
                      BorderThickness="{ThemeResource ElementBorderThickness}"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Top"
                      HorizontalContentAlignment="Left"
                      IsExpanded="True">
                <Expander.Header>
                    <Grid Padding="-15,20,-12,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="56" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE790;"
                                  Style="{StaticResource AppSymbolIconStyle}"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Center" />
                        <TextBlock x:Uid="chooseAccentColorSetting"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"
                                   Grid.Column="1" />
                        <ComboBox HorizontalContentAlignment="Left"
                                  VerticalAlignment="Center"
                                  Height="30"
                                  Width="120"
                                  MinWidth="120"
                                  Grid.Column="2"
                                  SelectedIndex="{x:Bind ViewModel.SelectedAccentIndex, Mode=TwoWay}">
                            <ComboBox.Items>
                                <ComboBoxItem x:Uid="system" />
                                <ComboBoxItem x:Uid="app" />
                                <ComboBoxItem x:Uid="custom" />
                            </ComboBox.Items>
                        </ComboBox>
                    </Grid>
                </Expander.Header>
                <Expander.Content>
                    <StackPanel Spacing="12" Margin="16,12">
                        <TextBlock x:Uid="quickPresets"
                                   FontWeight="Medium"
                                   FontSize="13"
                                   Opacity="0.8" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Uid="accentPresetOrange" Tag="#BE5A00" Width="38" Height="38" CornerRadius="19"
                                    Padding="0"
                                    Command="{x:Bind ViewModel.ApplyAccentPresetCommand}"
                                    CommandParameter="#BE5A00">
                                <Ellipse Fill="#BE5A00" Width="36" Height="36" />
                            </Button>
                            <Button x:Uid="accentPresetBlue" Tag="#0078D4" Width="38" Height="38" CornerRadius="19"
                                    Padding="0"
                                    Command="{x:Bind ViewModel.ApplyAccentPresetCommand}"
                                    CommandParameter="#0078D4">
                                <Ellipse Fill="#0078D4" Width="36" Height="36" />
                            </Button>
                            <Button x:Uid="accentPresetGreen" Tag="#107C10" Width="38" Height="38" CornerRadius="19"
                                    Padding="0"
                                    Command="{x:Bind ViewModel.ApplyAccentPresetCommand}"
                                    CommandParameter="#107C10">
                                <Ellipse Fill="#107C10" Width="36" Height="36" />
                            </Button>
                            <Button x:Uid="accentPresetRed" Tag="#E81123" Width="38" Height="38" CornerRadius="19"
                                    Padding="0"
                                    Command="{x:Bind ViewModel.ApplyAccentPresetCommand}"
                                    CommandParameter="#E81123">
                                <Ellipse Fill="#E81123" Width="36" Height="36" />
                            </Button>
                            <Button x:Uid="accentPresetPurple" Tag="#881798" Width="38" Height="38" CornerRadius="19"
                                    Padding="0"
                                    Command="{x:Bind ViewModel.ApplyAccentPresetCommand}"
                                    CommandParameter="#881798">
                                <Ellipse Fill="#881798" Width="36" Height="36" />
                            </Button>
                            <Button x:Uid="accentPresetRust" Tag="#CA5010" Width="38" Height="38" CornerRadius="19"
                                    Padding="0"
                                    Command="{x:Bind ViewModel.ApplyAccentPresetCommand}"
                                    CommandParameter="#CA5010">
                                <Ellipse Fill="#CA5010" Width="36" Height="36" />
                            </Button>
                        </StackPanel>
                        <ColorPicker HorizontalAlignment="Left"
                                     ColorSpectrumShape="Ring"
                                     IsMoreButtonVisible="False"
                                     IsColorSliderVisible="True"
                                     IsColorChannelTextInputVisible="True"
                                     IsHexInputVisible="True"
                                     IsAlphaEnabled="False"
                                     IsEnabled="{x:Bind ViewModel.IsCustomAccentSelected, Mode=OneWay}"
                                     Color="{x:Bind ViewModel.CustomAccentColor, Mode=TwoWay}" />
                    </StackPanel>
                </Expander.Content>
            </Expander>

            <!-- Keyboard shortcuts -->
            <controls:SettingsCard Glyph="&#xEDA7;">
                <controls:SettingsCard.Header>
                    <TextBlock x:Uid="newChapterShortcut" TextWrapping="Wrap" />
                </controls:SettingsCard.Header>
                <controls:SettingsCard.Description>
                    <TextBlock x:Uid="newChapterShortcutDesc" TextWrapping="Wrap" />
                </controls:SettingsCard.Description>
                <ToggleSwitch Style="{StaticResource RightAlignedToggleSwitchStyle}"
                              IsOn="{x:Bind ViewModel.AddChapterOnPageDownEnabled, Mode=TwoWay}" />
            </controls:SettingsCard>

            <!-- Text editor section -->
            <TextBlock x:Uid="textEditorSetting"
                       FontWeight="SemiBold"
                       Margin="0,10,0,5" />

            <controls:SettingsCard Glyph="&#xE8D2;">
                <controls:SettingsCard.Header>
                    <TextBlock x:Uid="editorFontFamilySetting" TextWrapping="Wrap" />
                </controls:SettingsCard.Header>
                <controls:SettingsCard.Description>
                    <TextBlock x:Uid="editorFontFamilySettingDesc" TextWrapping="Wrap" />
                </controls:SettingsCard.Description>
                <ComboBox HorizontalContentAlignment="Left"
                          VerticalAlignment="Center"
                          Height="30"
                          Width="160"
                          MinWidth="160"
                          SelectedValuePath="Tag"
                          SelectedValue="{x:Bind ViewModel.EditorFontFamily, Mode=TwoWay}">
                    <ComboBoxItem Content="Calibri" Tag="Calibri" />
                    <ComboBoxItem Content="Cambria" Tag="Cambria" />
                    <ComboBoxItem Content="Georgia" Tag="Georgia" />
                    <ComboBoxItem Content="Times New Roman" Tag="Times New Roman" />
                    <ComboBoxItem Content="Arial" Tag="Arial" />
                    <ComboBoxItem Content="Segoe UI" Tag="Segoe UI" />
                    <ComboBoxItem Content="Verdana" Tag="Verdana" />
                    <ComboBoxItem Content="Garamond" Tag="Garamond" />
                    <ComboBoxItem Content="Palatino Linotype" Tag="Palatino Linotype" />
                </ComboBox>
            </controls:SettingsCard>

            <controls:SettingsCard Glyph="&#xE8D2;">
                <controls:SettingsCard.Header>
                    <TextBlock x:Uid="editorFontSizeSetting" TextWrapping="Wrap" />
                </controls:SettingsCard.Header>
                <NumberBox Minimum="8"
                           Maximum="24"
                           SmallChange="1"
                           SpinButtonPlacementMode="Compact"
                           Width="100"
                           MinWidth="100"
                           Height="30"
                           Value="{x:Bind ViewModel.EditorFontSize, Mode=TwoWay}" />
            </controls:SettingsCard>

            <controls:SettingsCard Glyph="&#xE71E;">
                <controls:SettingsCard.Header>
                    <TextBlock x:Uid="zoom" TextWrapping="Wrap" />
                </controls:SettingsCard.Header>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <NumberBox Minimum="52"
                               Maximum="400"
                               SmallChange="10"
                               SpinButtonPlacementMode="Compact"
                               Width="100"
                               MinWidth="100"
                               Height="30"
                               Value="{x:Bind ViewModel.EditorZoomPercent, Mode=TwoWay}" />
                    <TextBlock Text="%" VerticalAlignment="Center" Opacity="0.8" />
                </StackPanel>
            </controls:SettingsCard>

        </StackPanel>
    </controls:SettingsPageLayout>
</Page>
