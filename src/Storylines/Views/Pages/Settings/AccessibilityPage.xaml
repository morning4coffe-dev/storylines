<Page x:Class="Storylines.Views.Pages.Settings.AccessibilityPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:controls="using:Storylines.Views.Controls"
      mc:Ignorable="d">

    <controls:SettingsPageLayout>
        <StackPanel Spacing="10">

            <TextBlock x:Uid="accessibilityText"
                       FontSize="25"
                       Margin="0,-5,0,5"
                       FontWeight="SemiBold" />

            <!-- Language -->
            <controls:SettingsCard Glyph="&#xF2B7;">
                <controls:SettingsCard.Header>
                    <TextBlock x:Uid="languageSetting" TextWrapping="Wrap" />
                </controls:SettingsCard.Header>
                <controls:SettingsCard.Description>
                    <TextBlock x:Uid="languageSettingDesc" TextWrapping="Wrap" />
                </controls:SettingsCard.Description>
                <ComboBox HorizontalContentAlignment="Left"
                          VerticalAlignment="Center"
                          Height="30"
                          Width="150"
                          MinWidth="150"
                          SelectedValuePath="Tag"
                          SelectedValue="{x:Bind ViewModel.SelectedLanguageTag, Mode=TwoWay}">
                    <ComboBox.Items>
                        <ComboBoxItem x:Uid="english" Tag="en" />
                        <ComboBoxItem x:Uid="chinese" Tag="zh-CN" />
                        <ComboBoxItem x:Uid="russian" Tag="ru" />
                        <ComboBoxItem x:Uid="italian" Tag="it" />
                        <ComboBoxItem x:Uid="czech" Tag="cs" />
                        <ComboBoxItem x:Uid="hindi" Tag="hi-IN" />
                        <ComboBoxItem x:Uid="polish" Tag="pl" />
                    </ComboBox.Items>
                </ComboBox>
            </controls:SettingsCard>

            <!-- Language restart banner -->
            <Border x:Name="languageRestartBanner"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource ElementBorderColor}"
                    BorderThickness="{ThemeResource ElementBorderThickness}"
                    CornerRadius="4"
                    Padding="16,12"
                    Visibility="{x:Bind ViewModel.LanguageRestartBannerVisibility, Mode=OneWay}">
                <StackPanel Spacing="10">
                    <TextBlock x:Uid="languageRestartText" TextWrapping="WrapWholeWords" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Uid="restartNowButton"
                                Style="{ThemeResource AccentButtonStyle}"
                                Command="{x:Bind ViewModel.RestartNowCommand}" />
                        <Button x:Uid="restartLaterButton"
                                Command="{x:Bind ViewModel.DismissRestartBannerCommand}" />
                    </StackPanel>
                    <InfoBar x:Uid="languageRestartFailedInfoBar"
                             IsClosable="False"
                             IsOpen="{x:Bind ViewModel.LanguageRestartFailed, Mode=OneWay}"
                             Severity="Warning" />
                </StackPanel>
            </Border>

            <!-- Display -->
            <controls:SettingsCard Glyph="&#xE7F4;">
                <controls:SettingsCard.Header>
                    <TextBlock x:Uid="whiteTextBackgroundSetting" TextWrapping="Wrap" />
                </controls:SettingsCard.Header>
                <ToggleSwitch x:Uid="whiteTextBackgroundToggle"
                              Style="{StaticResource RightAlignedToggleSwitchStyle}"
                              IsOn="{x:Bind ViewModel.TextBoxSolidBackground, Mode=TwoWay}" />
            </controls:SettingsCard>

            <!-- Read aloud section -->
            <TextBlock x:Uid="readAloudText"
                       FontWeight="SemiBold"
                       Margin="0,10,0,5" />

            <controls:SettingsCard Glyph="&#xE767;">
                <controls:SettingsCard.Header>
                    <TextBlock x:Uid="readAloudVolumeSetting" TextWrapping="Wrap" />
                </controls:SettingsCard.Header>
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind ViewModel.ReadAloudVolumeText, Mode=OneWay}"
                               VerticalAlignment="Center"
                               TextAlignment="Right"
                               Width="23"
                               Opacity="0.8" />
                    <Slider Width="150"
                            Value="{x:Bind ViewModel.ReadAloudVolume, Mode=TwoWay}"
                            Maximum="100"
                            Minimum="0" />
                    <Button Command="{x:Bind ViewModel.ToggleReadAloudMuteCommand}">
                        <FontIcon Glyph="{x:Bind ViewModel.ReadAloudVolumeGlyph, Mode=OneWay}"
                                  RenderTransformOrigin="0.70,0.75">
                            <FontIcon.RenderTransform>
                                <CompositeTransform ScaleX="0.8" ScaleY="0.8" />
                            </FontIcon.RenderTransform>
                        </FontIcon>
                    </Button>
                </StackPanel>
            </controls:SettingsCard>

            <controls:SettingsCard Glyph="&#xEFA9;">
                <controls:SettingsCard.Header>
                    <TextBlock x:Uid="readAloudVoiceSetting" TextWrapping="Wrap" />
                </controls:SettingsCard.Header>
                <ComboBox Width="180"
                          MinWidth="180"
                          ItemsSource="{x:Bind ViewModel.Voices, Mode=OneWay}"
                          DisplayMemberPath="DisplayName"
                          SelectedValuePath="Id"
                          SelectedValue="{x:Bind ViewModel.SelectedVoiceId, Mode=TwoWay}" />
            </controls:SettingsCard>

            <controls:SettingsCard Glyph="&#xEC57;">
                <controls:SettingsCard.Header>
                    <TextBlock x:Uid="readAloudRateSetting" TextWrapping="Wrap" />
                </controls:SettingsCard.Header>
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind ViewModel.ReadAloudRateText, Mode=OneWay}"
                               VerticalAlignment="Center"
                               Width="40"
                               TextAlignment="Right"
                               Opacity="0.8" />
                    <Slider Width="150"
                            Minimum="0.5"
                            Maximum="2.0"
                            StepFrequency="0.1"
                            TickFrequency="0.5"
                            Value="{x:Bind ViewModel.ReadAloudRate, Mode=TwoWay}" />
                </StackPanel>
            </controls:SettingsCard>

            <controls:SettingsCard Glyph="&#xE7F3;">
                <controls:SettingsCard.Header>
                    <TextBlock x:Uid="readAloudPitchSetting" TextWrapping="Wrap" />
                </controls:SettingsCard.Header>
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind ViewModel.ReadAloudPitchText, Mode=OneWay}"
                               VerticalAlignment="Center"
                               Width="40"
                               TextAlignment="Right"
                               Opacity="0.8" />
                    <Slider Width="150"
                            Minimum="0.0"
                            Maximum="2.0"
                            StepFrequency="0.1"
                            TickFrequency="0.5"
                            Value="{x:Bind ViewModel.ReadAloudPitch, Mode=TwoWay}" />
                </StackPanel>
            </controls:SettingsCard>

            <controls:SettingsCard Glyph="&#xE768;">
                <controls:SettingsCard.Header>
                    <TextBlock x:Uid="readAloudTestVoiceSetting" TextWrapping="Wrap" />
                </controls:SettingsCard.Header>
                <Button x:Uid="readAloudTestVoiceButton"
                        Command="{x:Bind ViewModel.TestVoiceCommand}" />
            </controls:SettingsCard>

            <controls:SettingsCard Glyph="&#xE720;">
                <controls:SettingsCard.Header>
                    <TextBlock x:Uid="dictationLanguageSetting" TextWrapping="Wrap" />
                </controls:SettingsCard.Header>
                <ComboBox Width="220"
                          MinWidth="220"
                          ItemsSource="{x:Bind ViewModel.DictationLanguages, Mode=OneWay}"
                          DisplayMemberPath="DisplayName"
                          SelectedValuePath="Tag"
                          SelectedValue="{x:Bind ViewModel.SelectedDictationLanguageTag, Mode=TwoWay}" />
            </controls:SettingsCard>

        </StackPanel>
    </controls:SettingsPageLayout>
</Page>
