<Page x:Class="Storylines.Views.Pages.Settings.AccessibilityPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/ResourceDictionaries/RightAlignedToggleSwitchStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="accessibilityPage"
                Margin="16,16,16,24"
                Spacing="10"
                    HorizontalAlignment="Stretch"
                    MaxWidth="1000">
            <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="CompactLayout">
                <VisualState.Setters>
                    <Setter Target="accessibilityPage.Margin"
                        Value="16,16,16,24" />
                    <Setter Target="languageControlColumn.Width"
                        Value="0" />
                    <Setter Target="langComboBox.(Grid.Row)"
                        Value="1" />
                    <Setter Target="langComboBox.(Grid.Column)"
                        Value="1" />
                    <Setter Target="langComboBox.(Grid.ColumnSpan)"
                        Value="2" />
                    <Setter Target="langComboBox.HorizontalAlignment"
                        Value="Left" />
                    <Setter Target="langComboBox.Margin"
                        Value="0,12,0,0" />
                    <Setter Target="readAloudVolumeControlColumn.Width"
                        Value="0" />
                    <Setter Target="readAloudVolumeStack.(Grid.Row)"
                        Value="1" />
                    <Setter Target="readAloudVolumeStack.(Grid.Column)"
                        Value="1" />
                    <Setter Target="readAloudVolumeStack.(Grid.ColumnSpan)"
                        Value="2" />
                    <Setter Target="readAloudVolumeStack.HorizontalAlignment"
                        Value="Left" />
                    <Setter Target="readAloudVolumeStack.Margin"
                        Value="0,12,0,0" />
                    <Setter Target="readAloudVolumeSlider.Width"
                        Value="120" />
                    <Setter Target="voiceControlColumn.Width"
                        Value="0" />
                    <Setter Target="voiceComboBox.(Grid.Row)"
                        Value="1" />
                    <Setter Target="voiceComboBox.(Grid.Column)"
                        Value="1" />
                    <Setter Target="voiceComboBox.(Grid.ColumnSpan)"
                        Value="2" />
                    <Setter Target="voiceComboBox.HorizontalAlignment"
                        Value="Left" />
                    <Setter Target="voiceComboBox.Margin"
                        Value="0,12,0,0" />
                </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="WideLayout">
                <VisualState.StateTriggers>
                    <AdaptiveTrigger MinWindowWidth="1400" />
                </VisualState.StateTriggers>
                <VisualState.Setters>
                    <Setter Target="accessibilityPage.Margin"
                        Value="32,24,32,24" />
                    <Setter Target="languageControlColumn.Width"
                        Value="Auto" />
                    <Setter Target="langComboBox.(Grid.Row)"
                        Value="0" />
                    <Setter Target="langComboBox.(Grid.Column)"
                        Value="2" />
                    <Setter Target="langComboBox.(Grid.ColumnSpan)"
                        Value="1" />
                    <Setter Target="langComboBox.HorizontalAlignment"
                        Value="Right" />
                    <Setter Target="langComboBox.Margin"
                        Value="0" />
                    <Setter Target="readAloudVolumeControlColumn.Width"
                        Value="Auto" />
                    <Setter Target="readAloudVolumeStack.(Grid.Row)"
                        Value="0" />
                    <Setter Target="readAloudVolumeStack.(Grid.Column)"
                        Value="2" />
                    <Setter Target="readAloudVolumeStack.(Grid.ColumnSpan)"
                        Value="1" />
                    <Setter Target="readAloudVolumeStack.HorizontalAlignment"
                        Value="Right" />
                    <Setter Target="readAloudVolumeStack.Margin"
                        Value="0" />
                    <Setter Target="readAloudVolumeSlider.Width"
                        Value="150" />
                    <Setter Target="voiceControlColumn.Width"
                        Value="Auto" />
                    <Setter Target="voiceComboBox.(Grid.Row)"
                        Value="0" />
                    <Setter Target="voiceComboBox.(Grid.Column)"
                        Value="2" />
                    <Setter Target="voiceComboBox.(Grid.ColumnSpan)"
                        Value="1" />
                    <Setter Target="voiceComboBox.HorizontalAlignment"
                        Value="Right" />
                    <Setter Target="voiceComboBox.Margin"
                        Value="0" />
                </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <TextBlock x:Uid="accessibilityText"
                       FontSize="25"
                       Margin="0,-5,0,5"
                       FontWeight="SemiBold" />

            <Grid Background="{ThemeResource LayerFillColorDefaultBrush}"
                  BorderBrush="{ThemeResource ElementBorderColor}"
                  BorderThickness="{ThemeResource ElementBorderThickness}"
                  CornerRadius="4"
              Padding="16,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                <ColumnDefinition Width="56" />
                    <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="languageControlColumn"
                          Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph=""
                  VerticalAlignment="Center"
                          HorizontalAlignment="Center" />
                <StackPanel VerticalAlignment="Center"
                            Spacing="1"
                            Grid.Column="1">
                    <TextBlock x:Uid="languageSetting"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap" />
                    <TextBlock x:Uid="languageSettingDesc"
                               FontWeight="Light"
                               Opacity="0.8"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,0,10,0" />
                </StackPanel>
                <ComboBox x:Name="langComboBox"
                          HorizontalAlignment="Right"
                          HorizontalContentAlignment="Left"
                          VerticalAlignment="Center"
                          Height="30"
                          Width="150"
                          MinWidth="150"
                          Grid.Column="2"
                          SelectedValuePath="Tag"
                          SelectedValue="{x:Bind ViewModel.SelectedLanguageTag, Mode=TwoWay}">
                    <ComboBox.Items>
                        <ComboBoxItem x:Uid="english"
                                      Tag="en" />
                        <ComboBoxItem x:Uid="chinese"
                                      Tag="zh-CN" />
                        <ComboBoxItem x:Uid="russian"
                                      Tag="ru" />
                        <ComboBoxItem x:Uid="italian"
                                      Tag="it" />
                        <ComboBoxItem x:Uid="czech"
                                      Tag="cs" />
                        <ComboBoxItem x:Uid="hindi"
                                      Tag="hi-IN" />
                        <ComboBoxItem x:Uid="polish"
                                      Tag="pl" />
                    </ComboBox.Items>
                </ComboBox>
            </Grid>

            <Border x:Name="languageRestartBanner"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource ElementBorderColor}"
                    BorderThickness="{ThemeResource ElementBorderThickness}"
                    CornerRadius="4"
                    Padding="16,12"
                        Visibility="{x:Bind ViewModel.LanguageRestartBannerVisibility, Mode=OneWay}">
                <StackPanel Spacing="10">
                    <TextBlock x:Uid="languageRestartText"
                               TextWrapping="WrapWholeWords" />
                    <StackPanel Orientation="Horizontal"
                                Spacing="8">
                        <Button x:Name="restartNowButton"
                                x:Uid="restartNowButton"
                                Style="{ThemeResource AccentButtonStyle}"
                            Command="{x:Bind ViewModel.RestartNowCommand}" />
                        <Button x:Name="restartLaterButton"
                                x:Uid="restartLaterButton"
                            Command="{x:Bind ViewModel.DismissRestartBannerCommand}" />
                    </StackPanel>
                    <InfoBar x:Name="languageRestartFailedInfoBar"
                                  x:Uid="languageRestartFailedInfoBar"
                                  IsClosable="False"
                              IsOpen="{x:Bind ViewModel.LanguageRestartFailed, Mode=OneWay}"
                                  Severity="Warning" />
                </StackPanel>
            </Border>

            <Grid Background="{ThemeResource LayerFillColorDefaultBrush}"
                  BorderBrush="{ThemeResource ElementBorderColor}"
                  BorderThickness="{ThemeResource ElementBorderThickness}"
                  CornerRadius="4"
                                    Padding="16,15">
                <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="56" />
                    <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph=""
                                                    VerticalAlignment="Center"
                          HorizontalAlignment="Center" />
                <TextBlock x:Uid="whiteTextBackgroundSetting"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           Grid.Column="1" />
                <ToggleSwitch x:Name="textBoxBackgroundToggleSwitch"
                              x:Uid="whiteTextBackgroundToggle"
                              Style="{StaticResource RightAlignedToggleSwitchStyle}"
                              HorizontalAlignment="Right"
                              Grid.Column="2"
                              IsOn="{x:Bind ViewModel.TextBoxSolidBackground, Mode=TwoWay}" />
            </Grid>

            <StackPanel>
                <TextBlock x:Uid="readAloudText"
                           FontWeight="SemiBold"
                           Margin="0,10,0,5" />
            </StackPanel>
            <Grid Background="{ThemeResource LayerFillColorDefaultBrush}"
                  BorderBrush="{ThemeResource ElementBorderColor}"
                  BorderThickness="{ThemeResource ElementBorderThickness}"
                  CornerRadius="4"
                  Padding="16,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="56" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="readAloudVolumeControlColumn"
                                      Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph=""
                          VerticalAlignment="Center"
                          HorizontalAlignment="Center" />
                <TextBlock x:Uid="readAloudVolumeSetting"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           Grid.Column="1" />

                <StackPanel x:Name="readAloudVolumeStack"
                            Orientation="Horizontal"
                            Spacing="10"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Right"
                            Grid.Column="2">
                    <TextBlock x:Name="readAloudVolumeText"
                               Text="{x:Bind ViewModel.ReadAloudVolumeText, Mode=OneWay}"
                               VerticalAlignment="Center"
                               TextAlignment="Right"
                               Width="23"
                               Opacity="0.8" />
                    <Slider x:Name="readAloudVolumeSlider"
                            Width="150"
                        Value="{x:Bind ViewModel.ReadAloudVolume, Mode=TwoWay}"
                            Maximum="100"
                            Minimum="0" />
                    <Button HorizontalAlignment="Right"
                             HorizontalContentAlignment="Center"
                            Command="{x:Bind ViewModel.ToggleReadAloudMuteCommand}">
                        <FontIcon x:Name="readAloudVolumeButtonIcon"
                                  Glyph="{x:Bind ViewModel.ReadAloudVolumeGlyph, Mode=OneWay}"
                                  RenderTransformOrigin="0.70,0.75">
                            <FontIcon.RenderTransform>
                                <CompositeTransform ScaleX="0.8"
                                                    ScaleY="0.8" />
                            </FontIcon.RenderTransform>
                        </FontIcon>
                    </Button>
                </StackPanel>
            </Grid>

            <Grid Background="{ThemeResource LayerFillColorDefaultBrush}"
                  BorderBrush="{ThemeResource ElementBorderColor}"
                  BorderThickness="{ThemeResource ElementBorderThickness}"
                  CornerRadius="4"
                  Padding="16,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="56" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="voiceControlColumn"
                                      Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph=""
                          VerticalAlignment="Center"
                          HorizontalAlignment="Center" />
                <TextBlock x:Uid="readAloudVoiceSetting"
                           VerticalAlignment="Center"
                           Grid.Column="1"
                           TextWrapping="Wrap" />
                <ComboBox x:Name="voiceComboBox"
                          Width="180"
                          MinWidth="180"
                          HorizontalAlignment="Right"
                          Grid.Column="2"
                          ItemsSource="{x:Bind ViewModel.Voices, Mode=OneWay}"
                          DisplayMemberPath="DisplayName"
                          SelectedValuePath="Id"
                          SelectedValue="{x:Bind ViewModel.SelectedVoiceId, Mode=TwoWay}" />
            </Grid>

            <StackPanel.ChildrenTransitions>
                <TransitionCollection>
                    <EntranceThemeTransition IsStaggeringEnabled="True"
                                             FromVerticalOffset="50" />
                </TransitionCollection>
            </StackPanel.ChildrenTransitions>
        </StackPanel>
    </ScrollViewer>
</Page>
