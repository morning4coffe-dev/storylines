<Page x:Class="Storylines.Views.Pages.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:components="using:Storylines.Views.Controls"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
      xmlns:vm="using:Storylines.ViewModels"
      Loaded="Page_Loaded"
      SizeChanged="OnPage_SizeChanged"
      mc:Ignorable="d">

    <Grid x:Name="mainGrid"
          x:FieldModifier="public">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3.57*" />
            <ColumnDefinition Width="*"
                              MinWidth="220"
                              MaxWidth="440" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
            <RowDefinition x:Name="notesRow" Height="0" />
            <RowDefinition Height="36" />
        </Grid.RowDefinitions>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="WideState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="800" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="textBoxZoomSliderZoomText.Visibility" Value="Visible" />
                        <Setter Target="textBoxZoomSlider.Visibility" Value="Visible" />
                        <Setter Target="storyInfoDetailedButton.Visibility" Value="Visible" />
                        <Setter Target="storyInfo.Visibility" Value="Collapsed" />
                        <Setter Target="downBarChapterName.Visibility" Value="Visible" />
                        <Setter Target="chapterTextBoxMainPage.Margin" Value="20" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="NarrowState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="textBoxZoomSliderZoomText.Visibility" Value="Collapsed" />
                        <Setter Target="textBoxZoomSlider.Visibility" Value="Collapsed" />
                        <Setter Target="storyInfoDetailedButton.Visibility" Value="Collapsed" />
                        <Setter Target="storyInfo.Visibility" Value="Visible" />
                        <Setter Target="downBarChapterName.Visibility" Value="Collapsed" />
                        <Setter Target="chapterTextBoxMainPage.Margin" Value="8" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Rectangle x:Name="line"
                   Grid.ColumnSpan="2"
                   Height="1"
                   VerticalAlignment="Top"
                   x:FieldModifier="public"
                   Fill="{ThemeResource SeparatorFill}"
                   Opacity="0.05" />

        <Rectangle Grid.ColumnSpan="2" />
        <components:MainCommandBar Grid.ColumnSpan="2"
                                   Margin="8,0"
                                   Visibility="{x:Bind ViewModel.DefaultCommandBarVisibility, Mode=OneWay}" />

        <components:ChapterTextBox x:Name="chapterTextBoxMainPage"
                                   Grid.Row="1"
                                   FormattingBarVisibility="{x:Bind ViewModel.FormattingBarVisibility, Mode=OneWay}"
                                   IsReadOnly="{x:Bind ViewModel.IsChapterTextReadOnly, Mode=OneWay}"
                                   Visibility="{x:Bind ViewModel.ChapterTextVisibility, Mode=OneWay}" />

        <ContentControl x:Name="modeOverlayHost"
                        Grid.Row="1"
                        Grid.ColumnSpan="2"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch"
                        IsTabStop="False"
                        Content="{x:Bind ViewModel.ModeOverlayContent, Mode=OneWay}" />

        <!-- Word-count goal progress bar — overlaid at the top of the writing area -->
        <ProgressBar x:Name="wordGoalProgressBar"
                     Grid.Row="1"
                     Height="3"
                     VerticalAlignment="Top"
                     Margin="0"
                     Minimum="0"
                     Maximum="100"
                     Value="{x:Bind ViewModel.WordGoalProgress, Mode=OneWay}"
                     Visibility="{x:Bind ViewModel.WordGoalVisibility, Mode=OneWay}"
                     IsHitTestVisible="False" />

        <components:ChaptersList x:Name="chapterListComponentMainPage"
                                 Grid.Row="1"
                                 Grid.Column="1"
                                 Margin="0,8,8,8"
                                 Visibility="{x:Bind ViewModel.ModeChapterListVisibility, Mode=OneWay}" />

        <components:ChapterNotesPane x:Name="chapterNotesPane"
                                     x:FieldModifier="public"
                                     Grid.Row="2"
                                     Grid.ColumnSpan="2"
                                     Margin="20,0,8,4"
                                     Visibility="Collapsed" />

        <Grid x:Name="downBarMainPage"
              Grid.Row="3"
              Grid.ColumnSpan="2"
              Background="{ThemeResource LayerFillColorDefaultBrush}"
              BorderBrush="{ThemeResource ElementBorderColor}"
              BorderThickness="{ThemeResource ElementBorderThickness}"
              Canvas.ZIndex="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="40" />
            </Grid.ColumnDefinitions>
            <muxc:ProgressBar x:Name="mainProgressBar"
                              Grid.ColumnSpan="3"
                              Margin="0,-1,0,3"
                              VerticalAlignment="Top"
                              x:FieldModifier="public"
                              Visibility="Collapsed" />

            <StackPanel Orientation="Horizontal"
                        Spacing="2"
                        VerticalAlignment="Center"
                        Margin="8,0,0,0">

                <Button x:Name="storyInfoDetailedButton"
                        x:Uid="storyInfoDetailedButton"
                        Padding="6,2"
                        MinHeight="28"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        CornerRadius="4"
                        Command="{x:Bind ViewModel.ShowProjectStatsCommand}"
                        ToolTipService.ToolTip="Click for detailed stats">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock x:Name="downBarWordsText"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   Foreground="{ThemeResource TextForeground}"
                                   Opacity="0.8"
                                   Text="{x:Bind ViewModel.DownBarWordsText, Mode=OneWay}" />
                        <TextBlock x:Name="downBarSep1"
                                   Text="|"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   Foreground="{ThemeResource TextForeground}"
                                   Opacity="0.5"
                                   Visibility="{x:Bind ViewModel.DownBarSeparatorsVisibility, Mode=OneWay}" />
                        <TextBlock x:Name="downBarCharsText"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   Foreground="{ThemeResource TextForeground}"
                                   Opacity="0.8"
                                   Text="{x:Bind ViewModel.DownBarCharsText, Mode=OneWay}" />
                        <TextBlock x:Name="downBarSep2"
                                   Text="|"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   Foreground="{ThemeResource TextForeground}"
                                   Opacity="0.5"
                                   Visibility="{x:Bind ViewModel.DownBarSeparatorsVisibility, Mode=OneWay}" />
                        <TextBlock x:Name="downBarReadTimeText"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   Foreground="{ThemeResource TextForeground}"
                                   Opacity="0.8"
                                   Text="{x:Bind ViewModel.DownBarReadTimeText, Mode=OneWay}" />
                    </StackPanel>
                </Button>

                <TextBlock x:Name="downBarText"
                           Visibility="Collapsed"
                           Foreground="{ThemeResource TextForeground}"
                           Text="{x:Bind ViewModel.DownBarText, Mode=OneWay}" />

                <HyperlinkButton x:Name="storyInfoDetailed"
                                 x:Uid="clickToSeeStoryAnalytics"
                                 VerticalAlignment="Center"
                                 Command="{x:Bind ViewModel.ShowProjectStatsCommand}"
                                 Visibility="Collapsed" />

                <Button x:Name="storyInfo"
                        Width="40"
                        Background="Transparent"
                        BorderThickness="0"
                        Command="{x:Bind ViewModel.ShowProjectStatsCommand}"
                        Visibility="Collapsed">
                    <FontIcon Margin="0,1,-5,0"
                              Glyph=""
                              Style="{StaticResource AppSymbolIconStyle}"
                              RenderTransformOrigin="0,.5">
                        <FontIcon.RenderTransform>
                            <CompositeTransform ScaleX=".75"
                                                ScaleY=".75" />
                        </FontIcon.RenderTransform>
                    </FontIcon>
                </Button>

                <TextBlock x:Name="downBarChapterName"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="{ThemeResource TextForeground}"
                           Opacity="0.5"
                           Margin="4,0,0,0"
                           Text="{x:Bind ViewModel.DownBarChapterName, Mode=OneWay}" />

                <!-- Guidance text when no chapter is selected -->
                <TextBlock x:Name="downBarGuidanceText"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="{ThemeResource TextForeground}"
                           Opacity="0.6"
                           Text="{x:Bind ViewModel.DownBarGuidanceText, Mode=OneWay}"
                           Visibility="{x:Bind ViewModel.DownBarGuidanceVisibility, Mode=OneWay}" />

                <TextBlock x:Name="downBarFocusText"
                           VerticalAlignment="Center"
                           x:FieldModifier="public"
                           Text="{x:Bind ViewModel.DownBarFocusText, Mode=OneWay}"
                           Foreground="{ThemeResource TextForeground}"
                           Visibility="{x:Bind ViewModel.DownBarFocusVisibility, Mode=OneWay}" />
            </StackPanel>

            <StackPanel Grid.Column="1"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal"
                        Spacing="5"
                        Margin="0,0,4,0">

                <!-- Session timer and streak badges -->
                <Button x:Name="sessionStreakButton"
                        Padding="6,2"
                        MinHeight="28"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        CornerRadius="4"
                        Visibility="{x:Bind ViewModel.SessionStreakVisibility, Mode=OneWay}"
                        Command="{x:Bind ViewModel.ShowProjectStatsCommand}"
                        ToolTipService.ToolTip="Writing streak — tap for session stats">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock x:Name="sessionTimerText"
                                   VerticalAlignment="Center"
                                   FontSize="{StaticResource AppCaptionFontSize}"
                                   Foreground="{ThemeResource TextForeground}"
                                   Opacity="0.7"
                                   Text="{x:Bind ViewModel.SessionTimerText, Mode=OneWay}" />
                        <TextBlock Text="|"
                                   VerticalAlignment="Center"
                                   FontSize="{StaticResource AppCaptionFontSize}"
                                   Foreground="{ThemeResource TextForeground}"
                                   Opacity="0.4" />
                        <TextBlock x:Name="streakText"
                                   VerticalAlignment="Center"
                                   FontSize="{StaticResource AppCaptionFontSize}"
                                   Foreground="{ThemeResource TextForeground}"
                                   Opacity="0.7"
                                   Text="{x:Bind ViewModel.StreakText, Mode=OneWay}" />
                    </StackPanel>
                </Button>

                <TextBlock x:Name="textBoxZoomSliderZoomText"
                           x:Uid="zoom"
                           Margin="5,0"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           FontSize="12" />

                <Slider x:Name="textBoxZoomSlider"
                        Width="100"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        IsEnabled="{x:Bind ViewModel.IsChapterSelected, Mode=OneWay}"
                        IsThumbToolTipEnabled="False"
                        Maximum="100"
                        Minimum="13"
                        ValueChanged="OnTextBoxZoomSlider_ValueChanged"
                        Value="25" />

                <HyperlinkButton x:Name="textBoxZoomTextHyperlink"
                                 MinWidth="50"
                                 Padding="6"
                                 HorizontalAlignment="Left"
                                 VerticalAlignment="Center"
                                 HorizontalContentAlignment="Center"
                                 Click="OnTextBoxZoomText_Click"
                                 IsEnabled="{x:Bind ViewModel.IsChapterSelected, Mode=OneWay}">
                    <TextBlock x:Name="textBoxZoomText"
                               VerticalAlignment="Center"
                               Foreground="{ThemeResource TextForeground}"
                               Text="{x:Bind ViewModel.ZoomText, Mode=OneWay}">
                        <TextBlock.ContextFlyout>
                            <Flyout x:Name="textBoxZoomTextFlyout">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock x:Uid="zoom"
                                                   FontWeight="Bold" />
                                        <AppBarButton x:Uid="resetZoomButton"
                                                      Width="40"
                                                      Height="40"
                                                      Margin="0,-10,-1,0"
                                                      HorizontalAlignment="Right"
                                                      Click="ResetZoomButton_Click"
                                                      ToolTipService.ToolTip="Reset">
                                            <AppBarButton.Icon>
                                                <FontIcon Glyph=""
                                                          RenderTransformOrigin="0.5,-0.5">
                                                    <FontIcon.RenderTransform>
                                                        <CompositeTransform ScaleX="0.8"
                                                                            ScaleY="0.8" />
                                                    </FontIcon.RenderTransform>
                                                </FontIcon>
                                            </AppBarButton.Icon>
                                        </AppBarButton>
                                    </Grid>
                                    <muxc:NumberBox x:Name="textBoxZoomTextFlyoutTextBox"
                                                    Width="180"
                                                    Height="38"
                                                    Padding="10,8"
                                                    HorizontalAlignment="Stretch"
                                                    CornerRadius="4"
                                                    LargeChange="100"
                                                    Maximum="400"
                                                    Minimum="20"
                                                    SmallChange="5"
                                                    SpinButtonPlacementMode="Compact"
                                                    ValueChanged="OnTextBoxZoomTextFlyoutTextBox_ValueChanged"
                                                    Value="100" />
                                </StackPanel>
                            </Flyout>
                        </TextBlock.ContextFlyout>
                    </TextBlock>
                </HyperlinkButton>
            </StackPanel>
            <Button x:Name="closeOpenChapterListComponent"
                    Grid.Column="2"
                    Width="40"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="OnCloseChapterListComponent_Click">
                <SymbolIcon x:Name="closeOpenChapterListComponentIcon"
                            Width="25"
                            Margin="0,0,-7,0"
                            RenderTransformOrigin="0,.5"
                            Symbol="OpenPane">
                    <SymbolIcon.RenderTransform>
                        <CompositeTransform ScaleX=".75"
                                            ScaleY=".75" />
                    </SymbolIcon.RenderTransform>
                </SymbolIcon>
            </Button>
        </Grid>
    </Grid>
</Page>

