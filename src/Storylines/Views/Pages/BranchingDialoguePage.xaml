<Page x:Class="Storylines.Views.Pages.BranchingDialoguePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
      xmlns:vm="using:Storylines.ViewModels"
      mc:Ignorable="d">

    <Grid x:Name="RootPage">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Padding="16,12"
              Background="{ThemeResource LayerFillColorDefaultBrush}"
              BorderBrush="{ThemeResource ElementBorderColor}"
              BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>

            <Button x:Name="backButton"
                    x:Uid="branchingBackButton"
                    Width="36"
                    Height="36"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="OnBackButton_Click">
                <FontIcon Glyph="&#xE72B;" />
            </Button>

            <StackPanel Grid.Column="1"
                        Orientation="Vertical"
                        Spacing="4"
                        Margin="8,0,0,0">
                <TextBlock x:Uid="branchingPageTitle"
                           FontSize="18"
                           FontWeight="SemiBold" />
                <TextBlock x:Uid="branchingPageSubtitle"
                           Opacity="0.7"
                           TextWrapping="WrapWholeWords" />
            </StackPanel>

            <ComboBox Grid.Column="2"
                      x:Uid="branchingChapterSelector"
                      ItemsSource="{x:Bind ViewModel.Chapters, Mode=OneWay}"
                      SelectedItem="{x:Bind ViewModel.SelectedChapter, Mode=TwoWay}"
                      DisplayMemberPath="Name"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Center" />
        </Grid>

        <Grid Grid.Row="1"
              Padding="12"
              ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>

            <!-- Left pane: node list + filters + optional map -->
            <Grid Grid.Column="0"
                  Background="{ThemeResource LayerFillColorDefaultBrush}"
                  BorderBrush="{ThemeResource ElementBorderColor}"
                  BorderThickness="{ThemeResource ElementBorderThickness}"
                  CornerRadius="8"
                  Padding="10"
                  RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="180" />
                </Grid.RowDefinitions>

                <TextBox x:Uid="branchingSearch"
                         Text="{x:Bind ViewModel.SearchText, Mode=TwoWay}"
                         PlaceholderText="Search nodes" />

                <ComboBox Grid.Row="1"
                          x:Uid="branchingSpeakerFilter"
                          ItemsSource="{x:Bind ViewModel.SpeakerFilters, Mode=OneWay}"
                          SelectedItem="{x:Bind ViewModel.SelectedSpeakerFilter, Mode=TwoWay}" />

                <ListView x:Name="nodesList"
                          Grid.Row="2"
                          ItemsSource="{x:Bind ViewModel.FilteredNodes, Mode=OneWay}"
                          SelectedItem="{x:Bind ViewModel.SelectedNode, Mode=TwoWay}">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Spacing="2">
                                <TextBlock Text="{Binding Title}"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Speaker}"
                                           Opacity="0.7"
                                           FontSize="12" />
                                <TextBlock Text="{Binding Text}"
                                           Opacity="0.8"
                                           MaxLines="2"
                                           TextTrimming="CharacterEllipsis"
                                           FontSize="12" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <StackPanel Grid.Row="3"
                            Orientation="Horizontal"
                            Spacing="8">
                    <Button x:Uid="branchingCreateNode"
                            Command="{x:Bind ViewModel.CreateNodeCommand}" />
                    <Button x:Uid="branchingDeleteNode"
                            Command="{x:Bind ViewModel.DeleteSelectedNodeCommand}" />
                    <Button x:Uid="branchingSetStartNode"
                            Command="{x:Bind ViewModel.SetStartNodeFromSelectionCommand}" />
                </StackPanel>

                <Grid Grid.Row="4"
                      RowSpacing="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <ToggleSwitch x:Uid="branchingMapToggle"
                                  IsOn="{x:Bind ViewModel.IsMapModeEnabled, Mode=TwoWay}"
                                  Toggled="OnMapToggle_Toggled" />

                    <ScrollViewer Grid.Row="1"
                                  x:Name="mapScrollViewer"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto"
                                  Visibility="Collapsed">
                        <Canvas x:Name="mapCanvas"
                                Width="1800"
                                Height="900" />
                    </ScrollViewer>
                </Grid>
            </Grid>

            <!-- Right pane: inspector + simulator -->
            <ScrollViewer Grid.Column="1"
                          Background="{ThemeResource LayerFillColorDefaultBrush}"
                          BorderBrush="{ThemeResource ElementBorderColor}"
                          BorderThickness="{ThemeResource ElementBorderThickness}"
                          CornerRadius="8"
                          Padding="12">
                <StackPanel Spacing="10">
                    <TextBlock x:Uid="branchingInspectorTitle"
                               FontSize="16"
                               FontWeight="SemiBold" />

                    <TextBox x:Uid="branchingNodeTitle"
                             Text="{Binding SelectedNode.Title, Mode=TwoWay}" />
                    <TextBox x:Uid="branchingNodeSpeaker"
                             Text="{Binding SelectedNode.Speaker, Mode=TwoWay}" />
                    <TextBox x:Uid="branchingNodeText"
                             Text="{Binding SelectedNode.Text, Mode=TwoWay}"
                             MinHeight="120"
                             
                             AcceptsReturn="True" /><!--TextWrapping="WrapWholeWords"-->

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Uid="branchingSaveNodeEdits"
                                Command="{x:Bind ViewModel.SaveNodeEditsCommand}" />
                        <Button x:Uid="branchingAddChoice"
                                Command="{x:Bind ViewModel.AddChoiceWithAutoDestinationCommand}" />
                    </StackPanel>

                    <ListView x:Name="choicesList"
                              ItemsSource="{Binding SelectedNode.Choices, Mode=OneWay}"
                              SelectedItem="{Binding SelectedChoice, Mode=TwoWay}">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3*" />
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0"
                                             Text="{Binding Text, Mode=TwoWay}" />
                                    <ComboBox Grid.Column="1"
                                              Loaded="OnChoiceTargetComboBox_Loaded"
                                              DisplayMemberPath="Title"
                                              SelectedValuePath="Id"
                                              SelectedValue="{Binding TargetNodeId, Mode=TwoWay}" />
                                    <Button Grid.Column="2"
                                            x:Uid="branchingRemoveChoice"
                                            Click="OnRemoveChoice_Click" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Uid="branchingValidateGraph"
                                Command="{x:Bind ViewModel.ValidateGraphCommand}" />
                        <TextBlock Text="{x:Bind ViewModel.ValidationSummary, Mode=OneWay}"
                                   VerticalAlignment="Center"
                                   TextWrapping="WrapWholeWords"
                                   Opacity="0.8" />
                    </StackPanel>

                    <muxc:Expander x:Uid="branchingSimulatorExpander"
                                   IsExpanded="True">
                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Uid="branchingSimulationStart"
                                        Command="{x:Bind ViewModel.StartSimulationCommand}" />
                                <Button x:Uid="branchingSimulationRestart"
                                        Command="{x:Bind ViewModel.RestartSimulationCommand}" />
                                <Button x:Uid="branchingSimulationStop"
                                        Command="{x:Bind ViewModel.StopSimulationCommand}" />
                            </StackPanel>

                            <TextBlock x:Uid="branchingSimulationBreadcrumb"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{x:Bind ViewModel.SimulatorBreadcrumb, Mode=OneWay}"
                                       TextWrapping="WrapWholeWords" />

                            <TextBlock Text="{x:Bind ViewModel.SimulatorCurrentSpeaker, Mode=OneWay}"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{x:Bind ViewModel.SimulatorCurrentText, Mode=OneWay}"
                                       TextWrapping="WrapWholeWords" />
                            <TextBlock Text="{x:Bind ViewModel.SimulatorStatus, Mode=OneWay}"
                                       Opacity="0.7" />

                            <ItemsControl ItemsSource="{Binding SimulationChoices, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding Text}"
                                                HorizontalAlignment="Stretch"
                                                Margin="0,2,0,2"
                                                Click="OnSimulationChoice_Click" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </muxc:Expander>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
