<Page x:Class="Storylines.Views.Pages.StoryPinboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:variables="using:Storylines.Models"
      xmlns:converters="using:Storylines.Converters"
      xmlns:animations="using:CommunityToolkit.WinUI.Animations"
      mc:Ignorable="d"
      Loaded="Page_Loaded">

    <Page.Resources>
        <converters:EmptyStringToCollapsedConverter x:Key="EmptyStringToCollapsedConverter" />
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Padding="20,16"
              Background="{ThemeResource LayerFillColorDefaultBrush}"
              BorderBrush="{ThemeResource ElementBorderColor}"
              BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0"
                        VerticalAlignment="Center">
                <TextBlock x:Uid="storyCanvasTitle"
                           FontSize="18"
                           FontWeight="SemiBold" />
                <TextBlock x:Name="subtitleText"
                           FontSize="12"
                           Opacity="0.6" />
            </StackPanel>
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Center">
                <!-- Tag filter -->
                <ComboBox x:Name="tagFilterComboBox"
                          x:Uid="pinboardTagFilter"
                          Width="160"
                          SelectionChanged="OnTagFilter_SelectionChanged"
                          VerticalAlignment="Center" />
                <!-- Connect mode toggle -->
                <ToggleButton x:Name="connectModeToggle"
                              ToolTipService.ToolTip="Connect chapters (click two cards to link them)"
                              Checked="OnConnectModeToggle_Checked"
                              Unchecked="OnConnectModeToggle_Unchecked"
                              Padding="8"
                              CornerRadius="4">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE71B;" FontSize="14" />
                        <TextBlock x:Uid="pinboardConnectLabel" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                </ToggleButton>
                <!-- Auto-arrange -->
                <Button x:Uid="pinboardAutoArrangeButton"
                        ToolTipService.ToolTip="Auto-arrange cards in a grid"
                        Padding="8"
                        CornerRadius="4"
                        Command="{x:Bind ViewModel.AutoArrangeChaptersCommand}">
                    <FontIcon Glyph="&#xE8A9;" FontSize="14" />
                </Button>
                <TextBlock x:Uid="pinboardHelpText"
                           FontSize="{StaticResource AppCaptionFontSize}"
                           Opacity="0.5"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- Canvas area with pan/zoom -->
        <ScrollViewer x:Name="canvasScrollViewer"
                      Grid.Row="1"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollMode="Enabled"
                      VerticalScrollMode="Enabled"
                      ZoomMode="Enabled"
                      MinZoomFactor="0.25"
                      MaxZoomFactor="2.0"
                      Background="{ThemeResource LayerFillColorAltBrush}">
            <Canvas x:Name="pinboardCanvas"
                    Width="4000"
                    Height="3000"
                    Tapped="OnCanvas_Tapped"
                    Background="Transparent" />
        </ScrollViewer>

        <!-- Empty state -->
        <StackPanel x:Name="emptyState"
                    Grid.Row="1"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Spacing="12"
                    Visibility="Collapsed">
            <FontIcon Glyph="&#xE8A1;"
                      FontSize="48"
                      HorizontalAlignment="Center"
                      Opacity="0.3" />
            <TextBlock x:Uid="pinboardEmptyTitle"
                       FontSize="16"
                       HorizontalAlignment="Center"
                       Opacity="0.5" />
            <TextBlock x:Uid="pinboardEmptyDescription"
                       FontSize="12"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       Opacity="0.4" />
        </StackPanel>
    </Grid>
</Page>
