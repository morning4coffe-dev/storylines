<UserControl x:Class="Storylines.Views.Controls.AppStatusFooter"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Height="30">

    <Grid Padding="12,4"
          Background="{ThemeResource ElementAcrylicBackground}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="auto" />
            <ColumnDefinition Width="auto" />
            <ColumnDefinition Width="auto" />
        </Grid.ColumnDefinitions>

        <!--  Left cluster: word count + goal progress  -->
        <StackPanel Grid.Column="0"
                    Orientation="Horizontal"
                    Spacing="12"
                    VerticalAlignment="Center">
            <TextBlock x:Name="wordCountText"
                       Text="{x:Bind WordCountLabel, Mode=OneWay}"
                       FontSize="12"
                       Opacity="0.85"
                       AutomationProperties.Name="Word count" />
            <TextBlock x:Name="goalText"
                       Text="{x:Bind GoalLabel, Mode=OneWay}"
                       Visibility="{x:Bind GoalVisibility, Mode=OneWay}"
                       FontSize="12"
                       Opacity="0.7" />
            <ProgressBar x:Name="goalProgress"
                         Value="{x:Bind GoalProgress, Mode=OneWay}"
                         Maximum="1"
                         Width="80"
                         Height="3"
                         Visibility="{x:Bind GoalVisibility, Mode=OneWay}" />
        </StackPanel>

        <!--  Mode badge  -->
        <Border Grid.Column="1"
                Padding="6,2"
                CornerRadius="4"
                Margin="8,0"
                Background="{ThemeResource SystemControlBackgroundBaseLowBrush}"
                Visibility="{x:Bind ModeBadgeVisibility, Mode=OneWay}">
            <TextBlock Text="{x:Bind ModeText, Mode=OneWay}"
                       FontSize="11"
                       Opacity="0.85" />
        </Border>

        <!--  Speech state  -->
        <FontIcon Grid.Column="2"
                  Glyph="{x:Bind SpeechGlyph, Mode=OneWay}"
                  FontSize="14"
                  Margin="6,0"
                  Visibility="{x:Bind SpeechIconVisibility, Mode=OneWay}"
                  ToolTipService.ToolTip="{x:Bind SpeechTooltip, Mode=OneWay}"
                  AutomationProperties.Name="{x:Bind SpeechTooltip, Mode=OneWay}" />

        <!--  Save indicator  -->
        <TextBlock Grid.Column="3"
                   Text="{x:Bind SaveIndicator, Mode=OneWay}"
                   FontSize="12"
                   Opacity="0.7"
                   VerticalAlignment="Center" />
    </Grid>
</UserControl>
