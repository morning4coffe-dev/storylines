<UserControl x:Class="Storylines.Views.Controls.ChapterTextBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:animations="using:CommunityToolkit.WinUI.Animations"
             xmlns:components="using:Storylines.Views.Controls"
             xmlns:variables="using:Storylines.Models"
             mc:Ignorable="d"
             d:DesignHeight="700"
             d:DesignWidth="1000"
             SizeChanged="UserControl_SizeChanged"
             Loaded="UserControl_Loaded">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/ResourceDictionaries/MainRichTextBoxStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid x:Name="gridHolder"
          x:FieldModifier="public"
          CornerRadius="8">
        <!--Background="{ThemeResource LayerFillColorDefaultBrush}" Canvas.ZIndex="1" BorderBrush="{ThemeResource ElementBorderColor}" BorderThickness="{ThemeResource ElementBorderThickness}"-->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="4.5" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="gridCommandBarHolder"
              x:FieldModifier="public"
              CornerRadius="8"
              Background="{ThemeResource LayerFillColorDefaultBrush}"
              Canvas.ZIndex="0"
              BorderBrush="{ThemeResource ElementBorderColor}"
              BorderThickness="{ThemeResource ElementBorderThickness}"
              Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="chapterTextCommandBarColumn"
                                  Width="*" />
                <ColumnDefinition Width="auto" />
            </Grid.ColumnDefinitions>

            <CommandBar x:Name="chapterTextCommandBar"
                        x:FieldModifier="public"
                        Canvas.ZIndex="3"
                        CornerRadius="4"
                        Background="Transparent"
                        UseLayoutRounding="True"
                        HorizontalAlignment="Left"
                        IsOpen="False"
                        DefaultLabelPosition="Collapsed"
                        CompositeMode="Inherit"
                        OverflowButtonVisibility="Collapsed">
                <AppBarToggleButton x:Name="boldTextButton"
                                    x:Uid="boldTextButton"
                                    x:FieldModifier="public"
                                    Tag="Bold"
                                    Icon="Bold"
                                    CornerRadius="4"
                                    Width="56"
                                    Click="OnFormatterButton_Click" />

                <AppBarToggleButton x:Name="italicTextButton"
                                    x:Uid="italicTextButton"
                                    x:FieldModifier="public"
                                    Tag="Italic"
                                    Icon="Italic"
                                    CornerRadius="4"
                                    Width="56"
                                    Click="OnFormatterButton_Click" />

                <AppBarToggleButton x:Name="underlineTextButton"
                                    x:Uid="underlineTextButton"
                                    x:FieldModifier="public"
                                    Tag="Underline"
                                    Icon="Underline"
                                    CornerRadius="4"
                                    Width="56"
                                    Click="OnFormatterButton_Click" />

                <AppBarToggleButton x:Name="strikethroughButton"
                                    x:Uid="strikethroughButton"
                                    x:FieldModifier="public"
                                    Tag="Strikethrough"
                                    CornerRadius="4"
                                    Visibility="Visible"
                                    Width="56"
                                    Click="OnFormatterButton_Click">
                    <AppBarToggleButton.Icon>
                        <FontIcon Glyph="" />
                    </AppBarToggleButton.Icon>
                </AppBarToggleButton>

                <AppBarElementContainer IsTabStop="False">
                    <Grid Height="48">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="3.5" />
                            <RowDefinition Height="5.1" />
                        </Grid.RowDefinitions>
                        <AppBarButton x:Name="highlighterButton"
                                      x:Uid="highlighterButton"
                                      x:FieldModifier="public"
                                      Tag="Highlighter"
                                      Icon="Highlight"
                                      CornerRadius="4"
                                      Width="56"
                                      Grid.RowSpan="3"
                                      LabelPosition="Collapsed"
                                      BorderThickness="1, 1, 0, 1"
                                      ToolTipService.ToolTip="Highlight (Ctrl+Shift+H, Right-click or hold to access more colors)"
                                      Click="OnFormatterButton_Click"
                                      Holding="OnHightighterButton_Holding"
                                      RightTapped="OnHightighterButton_RightClick">
                            <Flyout x:Name="highlighterButtonFlyout">
                                <StackPanel HorizontalAlignment="Stretch"
                                            Spacing="8">
                                    <TextBlock x:Uid="highlighterFlyout"
                                               FontWeight="Bold"
                                               Padding="0,0,0,4" />
                                    <StackPanel HorizontalAlignment="Stretch"
                                                Orientation="Horizontal"
                                                Spacing="8">
                                        <Button x:Uid="highlightYellow"
                                            Tag="Yellow"
                                                Height="38"
                                                Width="42"
                                                ToolTipService.ToolTip="Yellow"
                                                AutomationProperties.Name="Yellow highlight"
                                                Click="OnHighlighterColorButton_Click">
                                            <Rectangle Fill="#E5C126"
                                                       Margin="-25" />
                                        </Button>
                                        <Button x:Uid="highlightRed"
                                            Tag="Red"
                                                Height="38"
                                                Width="42"
                                                ToolTipService.ToolTip="Red"
                                                AutomationProperties.Name="Red highlight"
                                                Click="OnHighlighterColorButton_Click">
                                            <Rectangle Fill="#D61515"
                                                       Margin="-25" />
                                        </Button>
                                        <Button x:Uid="highlightGreen"
                                            Tag="Green"
                                                Height="38"
                                                Width="42"
                                                ToolTipService.ToolTip="Green"
                                                AutomationProperties.Name="Green highlight"
                                                Click="OnHighlighterColorButton_Click">
                                            <Rectangle Fill="#47CD3D"
                                                       Margin="-25" />
                                        </Button>
                                        <Button x:Uid="highlightBlue"
                                            Tag="Blue"
                                                Height="38"
                                                Width="42"
                                                ToolTipService.ToolTip="Blue"
                                                AutomationProperties.Name="Blue highlight"
                                                Click="OnHighlighterColorButton_Click">
                                            <Rectangle Fill="#1A41F6"
                                                       Margin="-25" />
                                        </Button>
                                    </StackPanel>
                                        <Button x:Uid="highlightNone"
                                            Tag="White"
                                            Height="34"
                                            Width="192"
                                            Click="OnHighlighterColorButton_Click" />
                                </StackPanel>
                            </Flyout>
                            <AppBarButton.KeyboardAccelerators>
                                <KeyboardAccelerator Modifiers="Control, Shift"
                                                     Key="H" />
                            </AppBarButton.KeyboardAccelerators>
                        </AppBarButton>
                        <Frame x:Name="highlighterButtonColor"
                               Background="#D61515"
                               Width="21"
                               CornerRadius="2"
                               Grid.Row="1" />
                    </Grid>
                </AppBarElementContainer>
                <AppBarButton x:Name="highlighterButtonMoreColors"
                              CornerRadius="4"
                              Width="23"
                              Click="OnHighlighterMoreButton_Click">
                    <AppBarButton.Icon>
                        <FontIcon Glyph=""
                                  Margin="7" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarSeparator Visibility="Collapsed" />
            </CommandBar>

            <AppBarButton x:Name="searchButton"
                          Icon="Find"
                          Grid.Column="2"
                          CornerRadius="4"
                          Width="56"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Center"
                          LabelPosition="Collapsed"
                          Margin="5,0"
                          Click="OnSearchButton_Click" />

            <TextBox x:Name="searchTextBox"
                     x:Uid="searchBox"
                     x:FieldModifier="public"
                     Visibility="Collapsed"
                     Grid.Column="2"
                     Grid.ColumnSpan="2"
                     Margin="7"
                     HorizontalAlignment="Stretch"
                     VerticalAlignment="Stretch"
                     CornerRadius="4"
                     Style="{StaticResource SmallTextBoxStyle}"
                     Width="320"
                     TextChanged="OnSearchTextBox_TextChanged"
                     PointerCaptureLost="OnSearchTextBox_PointerCaptureLost"
                     GotFocus="OnSearchTextBox_GotFocus"
                     LostFocus="OnSearchTextBox_LostFocus">
                <animations:Implicit.ShowAnimations>
                    <animations:SizeAnimation Duration="0:0:0.22"
                                              From="0, 50"
                                              To="320, 50" />
                </animations:Implicit.ShowAnimations>
            </TextBox>

        </Grid>

        <!-- Search & Replace Panel — floating overlay on text area -->
        <Border x:Name="searchReplacePanel"
                Visibility="Collapsed"
                Grid.Row="3"
                Canvas.ZIndex="10"
                VerticalAlignment="Top"
                HorizontalAlignment="Right"
                Margin="0,12,16,0"
                Padding="12"
                CornerRadius="8"
                Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                BorderThickness="1"
                MinWidth="360"
                MaxWidth="440">
            <Border.Shadow>
                <ThemeShadow />
            </Border.Shadow>

            <StackPanel Spacing="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="searchReplaceTitleText"
                               x:Uid="searchReplaceTitleText"
                               Style="{StaticResource BaseTextBlockStyle}"
                               FontSize="14"
                               VerticalAlignment="Center"
                               TextWrapping="NoWrap" />

                    <Button x:Uid="searchReplaceCloseButton"
                            Grid.Column="1"
                            Width="36"
                            Height="36"
                            Padding="0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Click="OnSearchReplaceClose_Click">
                        <SymbolIcon Symbol="Cancel" />
                    </Button>
                </Grid>

                <StackPanel Spacing="4">
                    <TextBlock x:Name="searchReplaceFindLabel"
                               x:Uid="searchReplaceFindLabel"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               FontWeight="SemiBold"
                               Opacity="0.72" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="searchReplaceFindBox"
                                 x:Uid="searchReplaceFindBox"
                                 x:FieldModifier="public"
                                 Height="38"
                                 Style="{StaticResource SmallTextBoxStyle}"
                                 AutomationProperties.LabeledBy="{Binding ElementName=searchReplaceFindLabel}"
                                 TextChanged="OnSearchReplaceFindBox_TextChanged" />
                        <Button x:Name="prevMatchButton"
                                x:Uid="prevMatchButton"
                                Grid.Column="1"
                                Width="38"
                                Height="38"
                                Padding="0"
                                Click="OnPrevMatch_Click">
                            <FontIcon Glyph="&#xE70E;"
                                      FontSize="{StaticResource AppCaptionFontSize}" />
                        </Button>
                        <Button x:Name="nextMatchButton"
                                x:Uid="nextMatchButton"
                                Grid.Column="2"
                                Width="38"
                                Height="38"
                                Padding="0"
                                Click="OnNextMatch_Click">
                            <FontIcon Glyph="&#xE70D;"
                                      FontSize="{StaticResource AppCaptionFontSize}" />
                        </Button>
                    </Grid>
                    <TextBlock x:Name="searchMatchCount"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Opacity="0.72"
                               TextWrapping="WrapWholeWords" />
                </StackPanel>

                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal"
                                Spacing="8">
                        <ToggleButton x:Name="matchCaseToggle"
                                      x:Uid="matchCaseToggle"
                                      MinWidth="110"
                                      Height="36"
                                      Padding="12,0"
                                      Click="OnMatchCaseToggle_Click" />
                        <ToggleButton x:Name="wholeWordToggle"
                                      x:Uid="wholeWordToggle"
                                      MinWidth="110"
                                      Height="36"
                                      Padding="12,0"
                                      Click="OnWholeWordToggle_Click" />
                    </StackPanel>
                    <ToggleButton x:Name="allChaptersScopeToggle"
                                  x:Uid="allChaptersScopeToggle"
                                  IsChecked="False"
                                  MinWidth="152"
                                  Height="36"
                                  Padding="12,0"
                                  HorizontalAlignment="Left"
                                  Checked="OnAllChaptersScopeToggle_Toggled"
                                  Unchecked="OnAllChaptersScopeToggle_Toggled" />
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock x:Name="searchReplaceReplaceLabel"
                               x:Uid="searchReplaceReplaceLabel"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               FontWeight="SemiBold"
                               Opacity="0.72" />
                    <TextBox x:Name="searchReplaceBox"
                             x:Uid="searchReplaceBox"
                             x:FieldModifier="public"
                             Height="38"
                             Style="{StaticResource SmallTextBoxStyle}"
                             AutomationProperties.LabeledBy="{Binding ElementName=searchReplaceReplaceLabel}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            Spacing="8"
                            HorizontalAlignment="Right">
                    <Button x:Name="replaceAllButton"
                            x:Uid="replaceAllButton"
                            MinWidth="128"
                            Height="38"
                            Click="OnReplaceAllButton_Click" />
                    <Button x:Name="replaceButton"
                            x:Uid="replaceButton"
                            MinWidth="100"
                            Height="38"
                            Style="{StaticResource AccentButtonStyle}"
                            Click="OnReplaceButton_Click" />
                </StackPanel>

                <animations:Implicit.ShowAnimations>
                    <animations:OpacityAnimation Duration="0:0:0.2"
                                                 From="0"
                                                 To="1.0" />
                </animations:Implicit.ShowAnimations>
            </StackPanel>
        </Border>

        <ScrollViewer x:Name="textBoxScrollViewer"
                      x:FieldModifier="public"
                      Background="{ThemeResource LayerFillColorDefaultBrush}"
                      Canvas.ZIndex="1"
                      Grid.Row="3"
                      HorizontalScrollBarVisibility="Hidden"
                      HorizontalScrollMode="Auto"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      CornerRadius="8"
                      BorderBrush="{ThemeResource ElementBorderColor}"
                      BorderThickness="{ThemeResource ElementBorderThickness}"
                      ViewChanged="OnTextBoxScrollViewer_ViewChanged"
                      Tapped="OnTextBoxRectangle_Tapped">
            <components:MyRichEditBox x:Name="textBox"
                                      x:FieldModifier="public"
                                      x:Uid="yourStory"
                                      IsHitTestVisible="False"
                                      Style="{StaticResource MainRichTextBoxStyle}"
                                      Foreground="{ThemeResource TextForeground}"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      IsSpellCheckEnabled="True"
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Top"
                                      GotFocus="OnTextBox_GotFocus"
                                      SelectionChanging="OnTextBox_SelectionChanging"
                                      TextChanged="OnTextBox_TextChanged"
                                      PreviewKeyDown="OnTextBox_PreviewKeyDown"
                                      Loaded="REBCustom_Loaded"
                                      Unloaded="REBCustom_Unloaded"
                                      LostFocus="OnTextBox_LostFocus"
                                      PointerWheelChanged="OnTextBox_PointerWheelChanged"
                                      Tapped="OnTextBoxRectangle_Tapped">
                <!--<RichEditBox.HandwritingView>
                    <HandwritingView PlacementAlignment="Auto" />
                </RichEditBox.HandwritingView>-->
            </components:MyRichEditBox>
        </ScrollViewer>

        <!-- Non-blocking dialogue character picker popup -->
        <Popup x:Name="dialoguePopup"
               Grid.Row="3"
               IsLightDismissEnabled="True"
               Closed="OnDialoguePopup_Closed">
            <Border Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="4"
                    MinWidth="220"
                    MaxWidth="300">
                <Border.Shadow>
                    <ThemeShadow />
                </Border.Shadow>
                <StackPanel Spacing="4">
                    <TextBlock x:Uid="dialoguePopupHint"
                               FontSize="{StaticResource AppCaptionFontSize}"
                               Opacity="0.6"
                               Margin="8,4,8,0" />

                    <ListView x:Name="dialoguePopupList"
                              MaxHeight="260"
                              SelectionMode="Single"
                              IsItemClickEnabled="True"
                              ItemClick="OnDialoguePopupCharacter_ItemClick">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="variables:Character">
                                <StackPanel Margin="0,2" Orientation="Horizontal" Spacing="8">
                                    <TextBlock FontWeight="SemiBold"
                                               Text="{x:Bind Name}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Opacity="0.5"
                                               Text="{x:Bind Role}"
                                               FontSize="12"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <TextBlock x:Name="dialoguePopupEmptyText"
                               x:Uid="dialoguePickerNoResults"
                               Opacity="0.6"
                               Margin="8,0"
                               FontSize="12"
                               TextWrapping="WrapWholeWords"
                               Visibility="Collapsed" />
                </StackPanel>
            </Border>
        </Popup>

        <!-- Teaching tip shown on first dialogue mode activation -->
        <TeachingTip x:Name="dialogueTeachingTip"
                          x:Uid="dialogueTeachingTip"
                          PreferredPlacement="Bottom"
                          IsLightDismissEnabled="True">
            <TeachingTip.IconSource>
                <FontIconSource Glyph="&#xE8BD;" />
            </TeachingTip.IconSource>
        </TeachingTip>

        <Rectangle x:Name="textBoxRectangle"
                   x:FieldModifier="public"
                   IsHitTestVisible="True"
                   Grid.Row="3"
                   Opacity="0.5"
                   Canvas.ZIndex="5"
                   Tapped="OnTextBoxRectangle_Tapped" />
    </Grid>
</UserControl>
