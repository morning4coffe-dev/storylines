<UserControl x:Class="Storylines.Views.Controls.DialogueEditor.BranchingDialogueEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewmodels="using:Storylines.ViewModels.Dialogue"
             mc:Ignorable="d"
             d:DesignHeight="700"
             d:DesignWidth="1000"
             Loaded="UserControl_Loaded">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="300" />
        </Grid.ColumnDefinitions>

        <!-- Left Pane: Nodes List -->
        <Grid Grid.Column="0" BorderBrush="{ThemeResource SystemControlForegroundChromeMediumBrush}" BorderThickness="0,0,1,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="Dialogue Nodes" FontWeight="Bold" Margin="10" />

            <ListView Grid.Row="1"
                      ItemsSource="{x:Bind ViewModel.Nodes}"
                      SelectedItem="{x:Bind ViewModel.SelectedNode, Mode=TwoWay}"
                      Margin="0,0,0,10">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="viewmodels:DialogueNodeViewModel">
                        <Grid Padding="5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind DisplayName, Mode=OneWay}" VerticalAlignment="Center" />
                            <Button Grid.Column="1"
                                    Content="🗑"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Command="{Binding DataContext.RemoveNodeCommand, ElementName=RootGrid}"
                                    CommandParameter="{x:Bind}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Button Grid.Row="2" Content="Add Node" Command="{x:Bind ViewModel.AddNodeCommand}" HorizontalAlignment="Stretch" Margin="10" />
        </Grid>

        <!-- Center Pane: Editor -->
        <Grid x:Name="RootGrid" Grid.Column="1" Padding="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,10" Visibility="{x:Bind ViewModel.SelectedNode, Converter={StaticResource NullToCollapsedConverter}}">
                <TextBlock Text="Speaker:" VerticalAlignment="Center" />
                <TextBox Text="{x:Bind ViewModel.SelectedNode.Speaker, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="200" />
                <Button Content="Preview JSON" Click="PreviewJson_Click" />
                <Button Content="Preview Text" Click="PreviewText_Click" />
            </StackPanel>

            <RichEditBox x:Name="EditorBox"
                         Grid.Row="1"
                         IsReadOnly="{x:Bind ViewModel.SelectedNode, Converter={StaticResource NullToTrueConverter}}"
                         TextChanging="EditorBox_TextChanging"
                         LostFocus="EditorBox_LostFocus"
                         PlaceholderText="Write your dialogue here... Use @ to tag entities."
                         AcceptsReturn="True" />

            <Popup x:Name="MentionsPopup" IsOpen="False" PlacementTarget="{x:Bind EditorBox}">
                <Border Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}"
                        BorderBrush="{ThemeResource SystemControlForegroundChromeMediumBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        MaxHeight="200">
                    <ListView x:Name="MentionsList"
                              ItemsSource="{x:Bind ViewModel.TagSource}"
                              ItemClick="MentionsList_ItemClick"
                              IsItemClickEnabled="True"
                              SelectionMode="Single"
                              Width="200">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Padding="5">
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" />
                                    <TextBlock Text="{Binding Category}" FontSize="10" Foreground="Gray" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Border>
            </Popup>
        </Grid>

        <!-- Right Pane: Choices -->
        <Grid Grid.Column="2" BorderBrush="{ThemeResource SystemControlForegroundChromeMediumBrush}" BorderThickness="1,0,0,0"
              Visibility="{x:Bind ViewModel.SelectedNode, Converter={StaticResource NullToCollapsedConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="Choices" FontWeight="Bold" Margin="10" />

            <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.SelectedNode.Choices, Mode=OneWay}" Margin="10">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="viewmodels:DialogueChoiceViewModel">
                        <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="4" Margin="0,0,0,10" Padding="10">
                            <StackPanel Spacing="5">
                                <TextBox Header="Choice Text" Text="{x:Bind ChoiceText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <ComboBox Header="Target Node"
                                          ItemsSource="{Binding DataContext.Nodes, ElementName=RootGrid}"
                                          DisplayMemberPath="DisplayName"
                                          SelectedValuePath="Id"
                                          SelectedValue="{x:Bind TargetNodeId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          HorizontalAlignment="Stretch" />
                                <Button Content="Remove Choice"
                                        Command="{Binding DataContext.RemoveChoiceCommand, ElementName=RootGrid}"
                                        CommandParameter="{x:Bind}"
                                        HorizontalAlignment="Right" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Button Grid.Row="2" Content="Add Choice" Command="{x:Bind ViewModel.AddChoiceCommand}" HorizontalAlignment="Stretch" Margin="10" />
        </Grid>
    </Grid>
</UserControl>
