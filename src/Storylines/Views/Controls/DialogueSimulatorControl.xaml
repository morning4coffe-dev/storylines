<UserControl
    x:Class="Storylines.Views.Controls.DialogueSimulatorControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    mc:Ignorable="d">

    <muxc:Expander x:Uid="branchingSimulatorExpander"
                   IsExpanded="False"
                   HorizontalAlignment="Stretch"
                   HorizontalContentAlignment="Stretch">
        <StackPanel Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <Button x:Uid="branchingSimulationStart" CornerRadius="4" Padding="8,4"
                        Click="OnStart_Click" />
                <Button x:Uid="branchingSimulationRestart" CornerRadius="4" Padding="8,4"
                        Click="OnRestart_Click" />
                <Button x:Uid="branchingSimulationStop" CornerRadius="4" Padding="8,4"
                        Click="OnStop_Click" />
            </StackPanel>

            <TextBlock x:Uid="branchingSimulationBreadcrumb" FontWeight="SemiBold" FontSize="12" />
            <TextBlock x:Name="breadcrumbText"
                       TextWrapping="WrapWholeWords" FontSize="12" Opacity="0.8" />

            <TextBlock x:Name="currentSpeakerText"
                       FontWeight="SemiBold" FontSize="13" />
            <TextBlock x:Name="currentText"
                       TextWrapping="WrapWholeWords" FontSize="12" />
            <TextBlock x:Name="statusText"
                       Opacity="0.6" FontSize="{StaticResource AppCaptionFontSize}" />

            <ItemsControl x:Name="choicesList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Content="{Binding Text}"
                                HorizontalAlignment="Stretch"
                                Margin="0,2" CornerRadius="4"
                                Click="OnChoice_Click" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Variables panel -->
            <muxc:Expander x:Uid="branchingVariablesExpander"
                           IsExpanded="False"
                           HorizontalAlignment="Stretch"
                           HorizontalContentAlignment="Stretch"
                           Padding="0">
                <ItemsControl x:Name="variablesList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnSpacing="8" Padding="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Key}" FontSize="{StaticResource AppCaptionFontSize}" FontWeight="SemiBold" Opacity="0.8" />
                                <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="{StaticResource AppCaptionFontSize}" Opacity="0.6" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </muxc:Expander>
        </StackPanel>
    </muxc:Expander>
</UserControl>
