<UserControl x:Class="Storylines.Views.Controls.WelcomePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:animations="using:CommunityToolkit.WinUI.Animations"
             mc:Ignorable="d"
             Loaded="OnWelcomePanel_Loaded">

    <Grid x:Name="welcomeRoot"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          MaxWidth="520"
          Padding="40">

        <animations:Implicit.ShowAnimations>
            <animations:OpacityAnimation Duration="0:0:0.5"
                                         From="0"
                                         To="1"
                                         EasingMode="EaseOut" />
            <animations:TranslationAnimation Duration="0:0:0.5"
                                             From="0, 24, 0"
                                             To="0"
                                             EasingMode="EaseOut" />
        </animations:Implicit.ShowAnimations>

        <StackPanel Spacing="28"
                    HorizontalAlignment="Center">

            <Grid HorizontalAlignment="Center"
                  Width="72" Height="72"
                  CornerRadius="20"
                  Background="{ThemeResource SystemAccentColor}"
                  Opacity="0.9">
                <FontIcon Glyph="&#xE736;"
                          FontSize="32"
                          Foreground="White"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />
            </Grid>

            <StackPanel Spacing="8"
                        HorizontalAlignment="Center">
                <TextBlock x:Uid="welcomePanelTitle"
                           FontSize="28"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Foreground="{ThemeResource TextForeground}" />

                <TextBlock x:Uid="welcomePanelDescription"
                           FontSize="14"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           Foreground="{ThemeResource TextForeground}"
                           Opacity="0.55"
                           TextWrapping="WrapWholeWords"
                           MaxWidth="360" />
            </StackPanel>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Spacing="12">

                <Button x:Name="newProjectButton"
                        Style="{ThemeResource AccentButtonStyle}"
                        Padding="24,12"
                        CornerRadius="6"
                        Click="OnNewProjectButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE710;" FontSize="15" />
                        <TextBlock x:Uid="welcomePanelNewProject"
                                   FontWeight="SemiBold" />
                    </StackPanel>
                </Button>

                <Button x:Name="openProjectButton"
                        Padding="24,12"
                        CornerRadius="6"
                        Click="OnOpenProjectButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE8E5;" FontSize="15" />
                        <TextBlock x:Uid="welcomePanelOpenProject"
                                   FontWeight="SemiBold" />
                    </StackPanel>
                </Button>

            </StackPanel>

            <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                    CornerRadius="8"
                    Padding="16,12"
                    HorizontalAlignment="Center"
                    MinWidth="340"
                    BorderBrush="{ThemeResource ElementBorderColor}"
                    BorderThickness="{ThemeResource ElementBorderThickness}"
                    Visibility="Collapsed"
                    x:Name="recentProjectsSection">
                <StackPanel Spacing="8">
                    <TextBlock x:Uid="welcomePanelRecentProjects"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Opacity="0.6" />
                    <ListView x:Name="recentProjectsList"
                              IsItemClickEnabled="True"
                              SelectionMode="None"
                              ItemClick="OnRecentProject_Click">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="0,4" />
                                <Setter Property="MinHeight" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}"
                                               FontSize="13"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding LastEditedFormatted}"
                                               Grid.Column="1"
                                               FontSize="{StaticResource AppCaptionFontSize}"
                                               Opacity="0.55"
                                               VerticalAlignment="Center"
                                               Margin="12,0,0,0" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>

            <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                    CornerRadius="8"
                    Padding="16,12"
                    HorizontalAlignment="Center"
                    BorderBrush="{ThemeResource ElementBorderColor}"
                    BorderThickness="{ThemeResource ElementBorderThickness}">
                <StackPanel Spacing="4"
                            Opacity="0.6">
                    <TextBlock x:Uid="welcomePanelKeyboardShortcuts"
                               FontSize="{StaticResource AppCaptionFontSize}"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                    <TextBlock x:Uid="welcomePanelKeyboardShortcutHint"
                               FontSize="{StaticResource AppCaptionFontSize}"
                               HorizontalAlignment="Center"
                               Foreground="{ThemeResource TextForeground}"
                               Opacity="0.8"
                               FontFamily="Consolas" />
                </StackPanel>
            </Border>

        </StackPanel>
    </Grid>
</UserControl>
