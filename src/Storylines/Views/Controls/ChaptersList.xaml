<UserControl x:Class="Storylines.Views.Controls.ChaptersList"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:variables="using:Storylines.Models"
             xmlns:converters="using:Storylines.Converters"
             xmlns:animations="using:Microsoft.Toolkit.Uwp.UI.Animations"
             xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="400">

    <UserControl.Resources>
        <converters:EmptyStringToCollapsedConverter x:Key="EmptyStringToCollapsedConverter" />
        <converters:ChapterStatusToColorConverter x:Key="StatusToColorConverter" />
    </UserControl.Resources>

    <Grid RightTapped="OnChaptersListView_RightTapped">
        <animations:Implicit.ShowAnimations>
            <animations:OpacityAnimation Duration="0:0:0.3"
                                         From="0"
                                         To="1"
                                         EasingMode="EaseOut" />
            <animations:TranslationAnimation Duration="0:0:0.3"
                                             From="20, 0, 0"
                                             To="0"
                                             EasingMode="EaseOut" />
        </animations:Implicit.ShowAnimations>

        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid VerticalAlignment="Center"
              Padding="4,0">
            <TextBlock x:Uid="chaptersText1"
                       FontWeight="SemiBold"
                       FontSize="13"
                       VerticalAlignment="Center"
                       Opacity="0.85" />
            <StackPanel HorizontalAlignment="Right"
                        Spacing="4"
                        Orientation="Horizontal">
                <Button x:Name="flyoutDisplayButton"
                        x:Uid="chapterListOptionsButton"
                        Width="28"
                        Height="28"
                        Background="Transparent"
                        BorderThickness="0"
                        CornerRadius="4"
                        Padding="0"
                        Click="OnFlyoutDisplayButton_Click">
                    <FontIcon Glyph="&#xE712;"
                              FontSize="12"
                              Opacity="0.6" />
                </Button>

                <Button x:Uid="chapterListCloseButton"
                        Width="28"
                        Height="28"
                        Background="Transparent"
                        BorderThickness="0"
                        CornerRadius="4"
                        Padding="0"
                        Click="OnCloseButton_Click">
                    <FontIcon Glyph="&#xE711;"
                              FontSize="10"
                              Opacity="0.6" />
                </Button>
            </StackPanel>
        </Grid>


        <Rectangle Fill="{ThemeResource SeparatorFill}"
                   Height="0.5"
                   Grid.Row="1"
                   Opacity=".08"
                   VerticalAlignment="Center"
                   Margin="0,2" />

        <ListView x:Name="listView"
                  x:FieldModifier="public"
                  ItemsSource="{x:Bind Chapters}"
                  CanReorderItems="True"
                  Grid.Row="2"
                  CanDragItems="True"
                  AllowDrop="True"
                  SelectionMode="Single"
                  Margin="-4,0"
                  SelectionChanged="OnChaptersList_SelectionChanged"
                  DragItemsCompleted="OnChaptersListView_DragItemsCompleted"
                  DragItemsStarting="OnChaptersListView_DragItemsStarting">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="variables:Chapter">
                    <Grid Tag="{Binding Token}"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Padding="4,6,4,6"
                          RightTapped="OnChaptersListViewItem_RightTapped"
                          DoubleTapped="OnChaptersListViewItem_DoubleTapped"
                          Holding="OnChaptersListViewItem_Holding">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Status dot -->
                        <Ellipse Width="8" Height="8"
                                 Margin="3,5,12,0"
                                 VerticalAlignment="Top"
                                 Grid.RowSpan="3">
                            <Ellipse.Fill>
                                <SolidColorBrush Color="{Binding Status, Converter={StaticResource StatusToColorConverter}}" />
                            </Ellipse.Fill>
                        </Ellipse>

                        <!-- Chapter name -->
                        <TextBlock Text="{Binding Name}"
                                   TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis"
                                   FontSize="13"
                                   Grid.Column="1"
                                   VerticalAlignment="Center" />

                        <!-- Status + Location line -->
                        <StackPanel Grid.Row="1" Grid.Column="1"
                                    Orientation="Horizontal" Spacing="6"
                                    Margin="0,2,0,0">
                            <TextBlock Text="{Binding Status}"
                                       FontSize="10"
                                       Opacity="0.55" />
                            <TextBlock Text="·"
                                       FontSize="10"
                                       Opacity="0.35"
                                       Visibility="{Binding Location, Converter={StaticResource EmptyStringToCollapsedConverter}}" />
                            <TextBlock Text="{Binding Location}"
                                       FontSize="10"
                                       Opacity="0.5"
                                       Visibility="{Binding Location, Converter={StaticResource EmptyStringToCollapsedConverter}}"
                                       TextTrimming="CharacterEllipsis"
                                       MaxWidth="120" />
                        </StackPanel>

                        <!-- Tag pills: visible only when chapter has tags -->
                        <muxc:ItemsRepeater Grid.Row="2"
                                       Grid.Column="1"
                                       ItemsSource="{Binding Tags}"
                                       Margin="0,3,0,0"
                                       Visibility="{Binding TagsText, Converter={StaticResource EmptyStringToCollapsedConverter}}">
                            <muxc:ItemsRepeater.Layout>
                                <muxc:StackLayout Orientation="Horizontal"
                                             Spacing="3" />
                            </muxc:ItemsRepeater.Layout>
                            <muxc:ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Border CornerRadius="3"
                                            Padding="5,1"
                                            Background="{ThemeResource SystemAccentColorLight2}"
                                            Opacity="0.85">
                                        <TextBlock Text="{x:Bind}"
                                                   FontSize="10"
                                                   Foreground="White"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                </DataTemplate>
                            </muxc:ItemsRepeater.ItemTemplate>
                        </muxc:ItemsRepeater>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel x:Name="noChaptersPlaceholder"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Grid.Row="2"
                    Spacing="14"
                    Padding="12"
                    RenderTransformOrigin=".5,.5">
            <FontIcon Glyph="&#xE1A5;"
                      FontSize="28"
                      HorizontalAlignment="Center"
                      Opacity="0.35" />
            <RichTextBlock FontSize="13"
                           Margin="12,0"
                           TextAlignment="Center"
                           Opacity="0.7"
                           IsTextSelectionEnabled="False">
                <Paragraph>
                    <Run x:Uid="noChapters" />
                    <LineBreak />
                    <Hyperlink Click="OnHyperlink_Click">
                        <Run x:Uid="clickHereText" />
                    </Hyperlink>
                    <Run x:Uid="toAddNew" />
                </Paragraph>
            </RichTextBlock>
            <animations:Implicit.ShowAnimations>
                <animations:ScaleAnimation Duration="0:0:0.32"
                                           From="1, 0.8, 0.1"
                                           To="1,1,1" />
            </animations:Implicit.ShowAnimations>
        </StackPanel>

        <Grid.Resources>
            <MenuFlyout x:Name="chaptersListViewFlyout"
                        Closed="ChaptersListViewItemFlyout_Closed">
                <MenuFlyout.Items>
                    <MenuFlyoutItem x:Name="addFlyout"
                                    x:Uid="addText"
                                    Click="OnChapterAdd_Click">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem x:Name="renameFlyout"
                                    x:Uid="renameFlyout"
                                    Click="OnChapterRename_Click">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem x:Name="removeFlyout"
                                    x:Uid="removeFlyout"
                                    Click="OnChapterDeleteFlyout_Click">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem x:Name="editTagsFlyout"
                                    x:Uid="editTagsFlyout"
                                    Click="OnChapterEditTags_Click">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE1CB;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutSubItem x:Name="setStatusFlyout" x:Uid="setStatusFlyout">
                        <MenuFlyoutSubItem.Icon>
                            <FontIcon Glyph="&#xE9D5;" />
                        </MenuFlyoutSubItem.Icon>
                        <MenuFlyoutItem x:Uid="statusDraft" Click="OnSetStatus_Click" Tag="Draft" />
                        <MenuFlyoutItem x:Uid="statusWriting" Click="OnSetStatus_Click" Tag="Writing" />
                        <MenuFlyoutItem x:Uid="statusRevision" Click="OnSetStatus_Click" Tag="Revision" />
                        <MenuFlyoutItem x:Uid="statusFinal" Click="OnSetStatus_Click" Tag="Final" />
                    </MenuFlyoutSubItem>
                </MenuFlyout.Items>
            </MenuFlyout>
        </Grid.Resources>
    </Grid>
</UserControl>
