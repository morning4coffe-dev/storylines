<UserControl
    x:Class="Storylines.Views.Controls.BranchingDialogueCanvasControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource LayerFillColorAltBrush}">
        <ScrollViewer x:Name="canvasScrollViewer"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollMode="Enabled"
                      VerticalScrollMode="Enabled"
                      ZoomMode="Enabled"
                      MinZoomFactor="0.25"
                      MaxZoomFactor="2.0">
            <Canvas x:Name="mapCanvas"
                    Width="4000" Height="3000"
                    Background="Transparent"
                    DoubleTapped="OnCanvas_DoubleTapped"
                    Tapped="OnCanvas_Tapped"
                    PointerMoved="OnCanvas_PointerMoved"
                    RightTapped="OnCanvas_RightTapped" />
        </ScrollViewer>

        <!-- Floating toolbar -->
        <StackPanel Orientation="Horizontal"
                    Spacing="4"
                    Padding="8"
                    Margin="12"
                    CornerRadius="8"
                    Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource ElementBorderColor}"
                    BorderThickness="1"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Bottom">
            <Button CornerRadius="4" Padding="10,6"
                    Click="OnAddNode_Click">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE710;" FontSize="12" />
                    <TextBlock x:Uid="branchingCanvasAddNode" FontSize="12" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <AppBarSeparator />
            <Button x:Uid="branchingCanvasAutoArrange"
                    CornerRadius="4" Padding="8"
                    Click="OnAutoArrange_Click">
                <FontIcon Glyph="&#xE8A9;" FontSize="14" />
            </Button>
            <Button x:Uid="branchingCanvasZoomIn"
                    CornerRadius="4" Padding="8"
                    Click="OnZoomIn_Click">
                <FontIcon Glyph="&#xE8A3;" FontSize="14" />
            </Button>
            <Button x:Uid="branchingCanvasZoomOut"
                    CornerRadius="4" Padding="8"
                    Click="OnZoomOut_Click">
                <FontIcon Glyph="&#xE71F;" FontSize="14" />
            </Button>
        </StackPanel>

        <!-- Connection mode banner -->
        <Border x:Name="connectionModeBanner"
                Visibility="Collapsed"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,8,0,0"
                Padding="12,6"
                CornerRadius="8"
                Background="{ThemeResource SystemAccentColorDark2}">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon Glyph="&#xE71B;" FontSize="14" Foreground="White" />
                <TextBlock x:Name="connectionModeText"
                           x:Uid="connectionModeText"
                           Foreground="White" FontSize="12" VerticalAlignment="Center" />
                <Button CornerRadius="4" Padding="6,2"
                    Click="OnCancelConnection_Click"
                        x:Uid="cancelConnectionButton" />
            </StackPanel>
        </Border>

        <!-- Empty state overlay -->
        <StackPanel x:Name="emptyState"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Spacing="12"
                    Visibility="Collapsed">
            <FontIcon Glyph="&#xE945;"
                      FontSize="48"
                      HorizontalAlignment="Center"
                      Opacity="0.3" />
            <TextBlock x:Uid="branchingEmptyTitle"
                       FontSize="16"
                       HorizontalAlignment="Center"
                       Opacity="0.5" />
            <TextBlock x:Uid="branchingEmptyDescription"
                       FontSize="12"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       Opacity="0.4"
                       MaxWidth="320" />
        </StackPanel>
    </Grid>
</UserControl>
