  "characters": [
    {
      "name": "Sable Vane",
      "description": "A freelance courier and occasional spy who has built a career on knowing when to deliver a message and when to lose it. Pragmatic to a fault, but with a stubborn moral floor she pretends not to have.",
      "pictureFileName": "sable.png",
      "role": "Protagonist",
      "age": "31",
      "appearance": "Lean, dark-complexioned, with close-cropped hair and a scar across the left eyebrow from a job that went badly three years ago. Dresses for utility, not fashion.",
      "traits": [
        "resourceful",
        "sardonic",
        "loyal under pressure",
        "distrustful of institutions"
      ],
      "relationships": [
        {
          "targetName": "Mira Aldric",
          "type": "Reluctant ally"
        },
        {
          "targetName": "Draven",
          "type": "Suspect / adversary"
        }
      ]
    },
    {
      "name": "Mira Aldric",
      "description": "The king's youngest daughter. Officially a minor figure at court — too young for political marriage, too quiet for influence. In practice, she spent years watching everything and saying nothing. She saw who started the fire.",
      "pictureFileName": "mira.png",
      "role": "Deuteragonist",
      "age": "17",
      "appearance": "Small for her age, with her father's grey eyes. Prefers dark, plain clothing that lets her go unnoticed. Always has ash under her fingernails — old habit from hiding near the palace furnaces as a child.",
      "traits": [
        "observant",
        "guarded",
        "quietly determined",
        "prone to catastrophising"
      ],
      "relationships": [
        {
          "targetName": "Sable Vane",
          "type": "Reluctant ally"
        },
        {
          "targetName": "Draven",
          "type": "Witness against / feared by"
        }
      ]
    },
    {
      "name": "Draven",
      "description": "High Steward of the realm. Managed the kingdom's finances and logistics for fifteen years under King Aldric. Brilliant administrator, genuinely beloved by the merchant class, and — if Mira is telling the truth — a murderer.",
      "pictureFileName": "draven.png",
      "role": "Antagonist",
      "age": "54",
      "appearance": "Tall, silver-haired, immaculately dressed. Has the kind of face that looks trustworthy in portraits. Warm handshake. Never raises his voice.",
      "traits": [
        "methodical",
        "politically brilliant",
        "charming",
        "ruthless when necessary"
      ],
