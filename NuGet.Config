    <!--
      Private feed for internal packages (e.g. future binary distribution of Storylines.DialoguePlugin).
      Replace the URL with your actual private feed endpoint.
      Uncomment when the feed is available.
    -->
    <!--
    <add key="Storylines-Private" value="https://pkgs.dev.azure.com/<org>/<project>/_packaging/<feed>/nuget/v3/index.json" />
    -->
  </packageSources>
</configuration>
