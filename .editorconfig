root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{cs,csx}]
indent_size = 4

[*.{ps1,psm1,psd1}]
indent_size = 4

[*.{sln,csproj,props,targets,resx,resw,xaml,xml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{yml,yaml,json,html,css,js,jsx,ts,tsx,py,dart}]
indent_size = 2
